---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = 'Better Home Technology — Adelaide Smart Home & Premium Electrical',
  description = 'Licensed Adelaide electricians. Smart home design for luxury builds, pre-purchase electrical inspections, switchboard upgrades. We tell you the truth about what your home needs.',
  ogImage = '/og-default.svg',
  noindex = false,
  ogType = 'website',
  canonicalPath,
  structuredData = [],
} = Astro.props;

const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site).toString();
const businessName = 'Better Home Technology';
const businessPhone = '+61-410-323-034';
const businessUrl = 'https://bhtechnology.com.au';
const businessAddress = {
  '@type': 'PostalAddress',
  addressLocality: 'Adelaide',
  addressRegion: 'SA',
  addressCountry: 'AU',
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: businessName,
  url: businessUrl,
  logo: new URL('/favicon.svg', Astro.site).toString(),
  sameAs: ['https://www.google.com/search?q=Better+Home+Technology+Adelaide'],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: businessName,
  telephone: businessPhone,
  url: businessUrl,
  image: new URL(ogImage, Astro.site).toString(),
  areaServed: 'Adelaide',
  address: businessAddress,
};

const schema = [orgSchema, localBusinessSchema, ...(Array.isArray(structuredData) ? structuredData : [structuredData])];
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      structuredData={schema}
    />

    <!-- Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- TODO: re-enable analytics after migration verified
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VWQL6TH7KQ"></script>
    -->
  </head>
  <body class="bg-brand-surface">
    <slot />
  </body>
</html>
