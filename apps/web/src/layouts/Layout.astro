---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import FaviconLinks from '../components/FaviconLinks.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = 'Better Home Technology — Adelaide Smart Home & Premium Electrical',
  description = 'Licensed Adelaide electricians. Smart home design for luxury builds, pre-purchase electrical inspections, switchboard upgrades. We tell you the truth about what your home needs.',
  ogImage = '/og-default.svg',
  noindex = false,
  ogType = 'website',
  canonicalPath,
  structuredData = [],
} = Astro.props;

const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site).toString();
const businessName = 'Better Home Technology';
const businessPhone = '+61-410-323-034';
const businessUrl = 'https://bhtechnology.com.au';
const businessAddress = {
  '@type': 'PostalAddress',
  addressLocality: 'Adelaide',
  addressRegion: 'SA',
  addressCountry: 'AU',
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: businessName,
  url: businessUrl,
  logo: new URL('/apple-touch-icon.png', Astro.site).toString(),
  sameAs: ['https://www.google.com/search?q=Better+Home+Technology+Adelaide'],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: businessName,
  telephone: businessPhone,
  url: businessUrl,
  image: new URL(ogImage, Astro.site).toString(),
  areaServed: 'Adelaide',
  address: businessAddress,
};

const schema = [orgSchema, localBusinessSchema, ...(Array.isArray(structuredData) ? structuredData : [structuredData])];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-VWQL6TH7KQ';
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const linkedInPartnerId = import.meta.env.PUBLIC_LINKEDIN_PARTNER_ID;
const enableAnalytics = import.meta.env.PROD && Boolean(gaMeasurementId);
const enableLinkedIn = import.meta.env.PROD && Boolean(linkedInPartnerId);
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      structuredData={schema}
    />

    <!-- Fonts: Inter (body) + Outfit (display headings). Single request, swap for CLS. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@400;500;600;700;800&family=Outfit:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <FaviconLinks />
    <title>{title}</title>
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    {enableAnalytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          {`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', gaMeasurementId);`}
        </script>
      </>
    )}
    {enableLinkedIn && (
      <script is:inline define:vars={{ linkedInPartnerId }}>
        {`window._linkedin_partner_id = linkedInPartnerId;
window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
window._linkedin_data_partner_ids.push(linkedInPartnerId);
(function(l) {
  if (!l) {
    window.lintrk = function(a,b){window.lintrk.q.push([a,b]);};
    window.lintrk.q = [];
  }
  var s = document.getElementsByTagName("script")[0];
  var b = document.createElement("script");
  b.type = "text/javascript"; b.async = true;
  b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
  s.parentNode.insertBefore(b, s);
})(window.lintrk);`}
      </script>
    )}
  </head>
  <body class="bg-brand-surface">
    <slot />
    <script is:inline>
      {`function bhtTrack(eventName, parameters) {
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push(Object.assign({ event: eventName }, parameters || {}));
}
document.addEventListener('click', function(event) {
  var link = event.target && event.target.closest ? event.target.closest('a[href]') : null;
  if (!link) return;
  var href = link.getAttribute('href') || '';
  if (href.indexOf('tel:') === 0) bhtTrack('contact_intent', { contact_method: 'phone' });
  else if (href === '/contact' || href.indexOf('/contact?') === 0) bhtTrack('contact_intent', { contact_method: 'form' });
  else if (href === '/shop' || href.indexOf('/shop?') === 0) bhtTrack('begin_selection', { link_text: (link.textContent || '').trim().slice(0, 80) });
  else if (href.indexOf('/better-home/') === 0 || href.indexOf('/products/') === 0) bhtTrack('view_product', { product_path: href.split('?')[0] });
});`}
    </script>
    {enableLinkedIn && (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none;"
          alt=""
          src={`https://px.ads.linkedin.com/collect/?pid=${linkedInPartnerId}&fmt=gif`}
        />
      </noscript>
    )}
  </body>
</html>
