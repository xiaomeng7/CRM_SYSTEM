---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';

// Secondary browsing — capability signals (no CCTV headline on homepage).
const services = [
  {
    href: '/services/smart-home',
    title: 'Smart Home Systems',
    eyebrow: 'Systems',
    icon: 'smart-home' as const,
    description:
      'Integrated lighting, comfort, access, and automation — specified with architecture and commissioned before handover.',
  },
  {
    href: '/services/smart-home',
    title: 'Architectural Lighting',
    eyebrow: 'Lighting',
    icon: 'lighting' as const,
    description:
      'Interior and exterior layers, scenes, and focal lighting aligned with design intent — not bolt-on downlights after paint.',
  },
  {
    href: '/for-builders/',
    title: 'New Build Electrical Infrastructure',
    eyebrow: 'Infrastructure',
    icon: 'blueprint' as const,
    description:
      'Distribution, containment, and smart-ready backbone coordinated with programme, trades, and documentation for luxury residential.',
  },
  {
    href: '/services/switchboard',
    title: 'Switchboard & Energy Capacity',
    eyebrow: 'Capacity',
    icon: 'switchboard' as const,
    description:
      'Protection, load planning, and headroom for climate, EV, and future phases — assessed before hardware is locked in.',
  },
];

// Recent Work strip — 4 photos. Captions stay specific to what's IN the photo,
// no fake locations. When real project data is added, swap captions for project names.
const recentWork = [
  {
    img: '/images/work-team-install',
    alt: 'Better Home Technology team member installing a custom curved chandelier',
    caption: 'On-site team — premium chandelier install',
    href: '/for-builders/',
  },
  {
    img: '/images/work-kitchen-led',
    alt: 'Modern kitchen with curved LED pendant light and warm cove lighting',
    caption: 'Custom kitchen lighting design',
    href: '/services/smart-home',
  },
  {
    img: '/images/work-builder-wiring',
    alt: 'Cable tray and conduit installation in a new luxury build',
    caption: 'Luxury new build — early-stage wiring',
    href: '/for-builders/',
  },
  {
    img: '/images/work-living-room-led',
    alt: 'Family living room with layered ceiling LED design',
    caption: 'Family living room — layered LED design',
    href: '/services/smart-home',
  },
];

/** Image-led proof — dark architectural frame (not blog / SaaS cards). */
const featuredProjects = [
  {
    img: '/images/work-exterior-night',
    alt: 'Luxury home exterior at night with architectural wall and entry lighting',
    title: 'Luxury New Build',
    descriptor: 'Architectural lighting, electrical infrastructure and smart-home readiness.',
    href: '/for-builders/',
  },
  {
    img: '/images/work-living-room-led',
    alt: 'Living room with layered ceiling LED and integrated lighting control',
    title: 'Smart Home Integration',
    descriptor: 'Lighting control, access, security and future-ready wiring.',
    href: '/services/smart-home',
  },
  {
    img: '/images/work-switchboard-panel',
    alt: 'Residential switchboard with DIN-rail breakers and organised terminations',
    title: 'Premium Electrical Infrastructure',
    descriptor: 'Switchboard capacity, circuit planning and clean system documentation.',
    href: '/services/switchboard',
  },
];
---

<Layout
  title="Smart Home & Premium Electrical for Better Homes | Better Home Technology"
  description="Premium residential electrical and smart infrastructure for luxury homes, builders, and modern projects. Independent pre-purchase inspections. Licensed electrical contractor — premium residential focus."
>
  <Header />

  <main>
    <!-- Hero — architectural luxury positioning for builders, architects, and premium residential -->
    <section
      class="relative min-h-[min(58vh,34rem)] overflow-hidden bg-brand-navy pb-16 pt-10 text-white md:min-h-[min(56vh,38rem)] md:pb-20 md:pt-12 lg:min-h-[min(60vh,40rem)] lg:pb-24 lg:pt-14"
    >
      <div class="absolute inset-0 z-0 bg-brand-navy" aria-hidden="true"></div>

      <div class="absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
        <img
          src="/front_page_background.jpg"
          alt=""
          width="1536"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute left-1/2 top-1/2 h-[118%] min-h-full w-[118%] min-w-full -translate-x-1/2 -translate-y-1/2 object-cover object-[58%_44%] sm:object-[60%_42%] md:h-[122%] md:w-[122%] md:object-[62%_40%] lg:object-[64%_38%] brightness-[0.58] contrast-[0.9] saturate-[0.72]"
        />
        <div class="absolute inset-0 bg-brand-navy/40"></div>
        <div class="pointer-events-none absolute inset-0 bht-hero-scrim-left"></div>
        <div class="pointer-events-none absolute inset-0 bht-hero-scrim-right"></div>
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-navy/90 via-brand-navy/20 to-brand-navy/50"
          aria-hidden="true"
        ></div>
        <div class="pointer-events-none absolute inset-0 bht-hero-vignette" aria-hidden="true"></div>
      </div>

      <div class="absolute inset-0 z-[2] pointer-events-none opacity-[0.12] bg-brand-pattern-dots-hero"></div>

      <div class="relative z-10 mx-auto w-full max-w-[1200px] px-6 lg:px-12">
        <div class="w-full max-w-[32rem] md:max-w-[34rem] lg:max-w-[36rem] -translate-y-4 md:-translate-y-[4.5vh] lg:-translate-y-[5.5vh]">
          <p class="text-brand-amber/80 text-[10px] md:text-[11px] font-semibold tracking-[0.18em] uppercase mb-6 md:mb-7">
            Premium Residential Systems
          </p>
          <h1
            class="font-bold tracking-[-0.036em] leading-[1.02] text-[clamp(1.95rem,3.9vw+0.4rem,3.35rem)] drop-shadow-[0_2px_28px_rgba(0,0,0,0.48)]"
          >
            <span class="block text-white">Smart Home &amp; Premium Electrical</span>
            <span class="block text-brand-amber mt-2 md:mt-2.5">for Better Homes.</span>
          </h1>
          <p class="mt-8 md:mt-9 text-[15px] md:text-[16px] text-[#E8EAED]/86 max-w-[28rem] leading-[1.58] drop-shadow-[0_1px_14px_rgba(0,0,0,0.42)]">
            Premium electrical, lighting and smart-home systems for modern residential projects.
          </p>
          <div class="mt-10 md:mt-12 flex flex-col sm:flex-row gap-4 sm:gap-5 sm:items-center">
            <a
              href="/for-builders/"
              class="inline-flex min-h-[52px] items-center justify-center bg-brand-amber text-brand-navy px-10 md:px-12 py-3.5 text-sm font-semibold tracking-[0.03em] rounded-[2px] hover:bg-brand-amber-soft/95 transition-colors duration-500 ease-out text-center shadow-[0_4px_28px_rgba(198,165,94,0.14)]"
            >
              Partner with us on your next build
            </a>
            <a
              href="#services"
              class="inline-flex min-h-[52px] items-center justify-center border border-white/[0.11] bg-white/[0.025] px-9 py-3.5 text-sm font-medium tracking-[0.025em] text-white/80 shadow-none backdrop-blur-[1.5px] transition-colors duration-700 ease-out hover:border-white/[0.16] hover:bg-white/[0.045] hover:text-white/92 md:px-11 rounded-[2px] text-center"
            >
              View residential services
            </a>
          </div>
          <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-x-7 gap-y-2.5 text-[10px] md:text-[11px] text-slate-500/95 tracking-[0.07em] uppercase">
            <span class="flex items-center gap-1.5">
              <span class="text-brand-amber/55" aria-hidden="true">✓</span> Licensed PGE275430
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-brand-amber/55" aria-hidden="true">★</span> 5.0 Google Rating
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-brand-amber/55" aria-hidden="true">◆</span> 3-Year Workmanship Warranty
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust strip — middle-of-page credibility anchor. For brand traffic
         (referrals, "Google our company name" visitors), this is the
         "are these people legit?" answer in one row. -->
    <section class="border-y border-white/[0.06] bg-brand-charcoal-elevated">
      <div class="mx-auto max-w-4xl px-6 py-8 md:max-w-[52rem] md:px-10 md:py-10 text-center">
        <p class="text-sm md:text-[15px] text-slate-300/95 leading-relaxed max-w-3xl mx-auto mb-5 md:mb-6">
          Licensed electrical contractor serving Adelaide premium residential projects.
        </p>
        <div class="grid grid-cols-3 gap-x-3 md:gap-x-8 text-center">
          <div>
            <p class="text-base font-bold text-white md:text-lg">Licensed</p>
            <p class="mt-1 text-[10px] uppercase tracking-wider text-slate-400 md:text-[11px]">PGE275430</p>
          </div>
          <div>
            <p class="text-base font-bold text-brand-amber md:text-lg">3 Years</p>
            <p class="mt-1 text-[10px] uppercase tracking-wider text-slate-400 md:text-[11px]">Workmanship</p>
          </div>
          <div>
            <p class="text-base font-bold text-white md:text-lg">5.0 <span class="text-brand-amber">★</span></p>
            <p class="mt-1 text-[10px] uppercase tracking-wider text-slate-400 md:text-[11px]">Google</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured residential projects — credibility layer, charcoal / gold (architectural). -->
    <section class="border-y border-white/[0.06] bg-brand-charcoal-deep py-16 text-white md:py-24 lg:py-28">
      <div class="mx-auto max-w-6xl px-6 lg:px-10">
        <div class="max-w-3xl mb-12 md:mb-16">
          <p class="text-brand-amber/75 text-[11px] md:text-xs font-semibold tracking-[0.22em] uppercase mb-4">
            Selected work
          </p>
          <h2 class="text-3xl font-bold tracking-[-0.03em] text-white md:text-[2.35rem] leading-[1.12]">
            Featured Residential Projects
          </h2>
          <p class="mt-4 max-w-2xl text-base leading-[1.58] text-slate-400 md:text-lg">
            Selected electrical, lighting and smart-home infrastructure work for premium residential builds.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8 lg:gap-10">
          {featuredProjects.map((proj) => (
            <a href={proj.href} class="group block">
              <div class="aspect-[4/3] overflow-hidden bg-brand-navy ring-1 ring-white/[0.06]">
                <picture>
                  <source srcset={`${proj.img}.webp`} type="image/webp" />
                  <img
                    src={`${proj.img}.jpg`}
                    alt={proj.alt}
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-[700ms] ease-out group-hover:scale-[1.02] group-hover:opacity-95"
                  />
                </picture>
              </div>
              <div class="border-t border-brand-amber/40 bg-brand-navy/55 px-0 pt-6 pb-1 md:pt-7">
                <h3 class="text-lg font-bold tracking-[-0.02em] text-white transition-colors duration-300 group-hover:text-brand-amber-soft md:text-xl">
                  {proj.title}
                </h3>
                <p class="mt-2.5 text-sm leading-[1.55] text-slate-400 md:text-[15px]">
                  {proj.descriptor}
                </p>
              </div>
            </a>
          ))}
        </div>
        <p class="mt-14 text-center md:mt-16">
          <a
            href="/projects"
            class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500 transition-colors duration-500 hover:text-brand-amber/80"
          >
            View all projects →
          </a>
        </p>
      </div>
    </section>

    <!-- 2-card routing — two distinct audiences with distinct journeys.
         Builder/designer is primary (brand repositioning goal).
         Pre-purchase is secondary (current B2C volume). -->
    <section class="bg-white py-14 md:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-10">
        <div class="max-w-2xl mb-10 md:mb-14 md:max-w-[42rem] pt-0.5 pl-[3px] md:pl-1">
          <p class="text-brand-amber/90 text-[10.5px] md:text-[11px] font-semibold tracking-[0.22em] uppercase mb-4 md:mb-5">
            Who we work with
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-ink tracking-[-0.03em] leading-tight">
            Two different projects. One delivery standard.
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">

          <!-- Card 1: Builder / designer — PRIMARY (brand repositioning goal) -->
          <a href="/for-builders/"
             class="group block bg-brand-navy text-white rounded-lg p-8 md:p-10 border border-brand-navy/90 hover:shadow-xl transition-shadow duration-500 relative overflow-hidden">
            <div class="absolute inset-0 pointer-events-none opacity-60 bg-brand-pattern-dots-soft"></div>
            <div class="relative">
              <div class="flex items-start justify-between gap-5 mb-6 md:mb-7">
                <span class="inline-block self-start bg-brand-amber text-brand-navy text-[11px] font-bold px-2.5 py-0.5 rounded tracking-[0.08em] uppercase max-w-[min(100%,15rem)] leading-snug md:max-w-[min(100%,17rem)]">
                  Builders &amp; design teams
                </span>
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[5px] border border-white/[0.14] bg-white/[0.06] text-brand-amber/95"
                  aria-hidden="true"
                >
                  <Icon name="blueprint" class="h-[1.575rem] w-[1.575rem] -translate-y-px" />
                </div>
              </div>
              <h3 class="text-xl md:text-2xl font-bold mb-3 tracking-[-0.02em] leading-snug">Building or designing a premium home</h3>
              <p class="text-slate-300/95 text-sm md:text-base leading-[1.62] mb-5 md:mb-6">
                Electrical, lighting, and smart infrastructure coordinated with your programme,
                documentation, and handover — so the home matches the design intent.
              </p>
              <p class="text-sm font-medium tracking-[0.02em] text-brand-amber/95 group-hover:text-brand-amber-soft transition-colors duration-500">
                Explore builder partnerships →
              </p>
            </div>
          </a>

          <!-- Card 2: Pre-purchase inspection — B2C product -->
          <a href="/pre-purchase-inspection"
             class="group block rounded-lg border border-brand-navy/[0.09] bg-brand-surface-alt p-8 shadow-[0_1px_0_rgba(15,23,42,0.04)] transition-all duration-500 hover:border-brand-navy/[0.14] hover:shadow-[0_18px_48px_-22px_rgba(15,23,42,0.14)] md:p-10">
              <div class="flex items-start justify-between gap-5 mb-6 md:mb-7">
                <span class="inline-block self-start bg-brand-amber text-brand-navy text-[11px] font-bold px-2.5 py-0.5 rounded tracking-[0.08em] uppercase max-w-[min(100%,15rem)] leading-snug md:max-w-[min(100%,17rem)]">
                  Pre-purchase inspection
                </span>
                <div
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[5px] border border-brand-navy/[0.12] bg-brand-navy/[0.055] text-brand-navy/[0.78] transition-colors duration-500 group-hover:border-brand-navy/[0.16] group-hover:bg-brand-navy/[0.075] group-hover:text-brand-navy/[0.88]"
                  aria-hidden="true"
                >
                  <Icon name="inspection" class="h-[1.625rem] w-[1.625rem] translate-y-px" />
                </div>
              </div>
              <h3 class="text-xl md:text-2xl font-bold text-brand-ink mb-3 tracking-[-0.02em] leading-snug">Buying before you commit</h3>
              <p class="text-sm text-slate-600 md:text-base md:leading-[1.62] leading-[1.58] mb-5 md:mb-6">
                Independent electrical inspection and written report before you sign — clear scope,
                clear risk, and no sales commission on the outcome.
              </p>
              <p class="text-sm font-medium tracking-[0.02em] text-brand-navy/75 transition-colors duration-500 group-hover:text-brand-amber">
                Book pre-purchase inspection →
              </p>
          </a>

        </div>
      </div>
    </section>

    <!-- Services Grid — browse all, for SEO + detail-oriented visitors -->
    <section id="services" class="bg-brand-surface-alt py-14 md:py-20 lg:py-24 scroll-mt-20">
      <div class="mx-auto max-w-6xl px-6 lg:px-10">
        <div class="max-w-2xl mb-10 md:mb-14 md:max-w-[42rem] pt-0.5 pl-[3px] md:pl-1">
          <p class="text-[10.5px] font-semibold uppercase tracking-[0.22em] text-brand-amber/90 md:text-[11px] mb-4 md:mb-5">
            Or browse by service
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-ink tracking-[-0.03em] leading-tight">
            Capabilities
          </h2>
          <p class="mt-3 text-base leading-[1.58] text-slate-600 md:mt-4 md:text-[17px]">
            Secondary browsing — same delivery standard when you are ready to go deeper on scope.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4 lg:gap-6">
          {services.map((service) => (
            <ServiceCard
              href={service.href}
              title={service.title}
              description={service.description}
              icon={service.icon}
              eyebrow={service.eyebrow}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Recent Work strip — 4 real install photos, 1-line captions -->
    <section class="bg-white py-14 md:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-6 lg:px-10">
        <div class="flex items-end justify-between gap-6 mb-8 md:mb-12">
          <div class="max-w-xl">
            <p class="text-brand-amber text-[11px] md:text-xs font-semibold tracking-[0.2em] uppercase mb-3">
              Selected projects
            </p>
            <h2 class="text-3xl md:text-4xl font-bold text-brand-ink tracking-[-0.03em] leading-tight">
              Recent work from the field.
            </h2>
          </div>
          <a href="/projects" class="hidden sm:inline-block text-sm font-medium text-brand-navy/75 hover:text-brand-amber transition-colors duration-300 tracking-wide uppercase">
            View projects →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
          {recentWork.map((item) => (
            <a href={item.href} class="group block">
              <div class="aspect-[4/3] overflow-hidden bg-brand-surface-alt">
                <picture>
                  <source srcset={`${item.img}.webp`} type="image/webp" />
                  <img
                    src={`${item.img}.jpg`}
                    alt={item.alt}
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition duration-[600ms] ease-out group-hover:scale-[1.03]"
                  />
                </picture>
              </div>
              <p class="mt-3 text-xs md:text-sm font-medium text-brand-ink/90 group-hover:text-brand-navy transition-colors duration-300 leading-snug">
                {item.caption}
              </p>
            </a>
          ))}
        </div>

        <div class="mt-8 sm:hidden text-center">
          <a href="/projects" class="text-sm font-medium text-brand-navy/75 hover:text-brand-amber transition-colors uppercase tracking-wide">
            View projects →
          </a>
        </div>
      </div>
    </section>

    <!-- Brand promise — builder-facing; inspection-specific promise lives on /pre-purchase-inspection -->
    <section class="bg-brand-navy text-white py-16 md:py-24 lg:py-24 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none opacity-60 bg-brand-pattern-dots-soft"></div>

      <div class="relative mx-auto max-w-4xl px-6 text-center md:text-left md:mx-auto md:max-w-6xl lg:px-10">
        <div class="md:grid md:grid-cols-[1fr_auto] md:gap-14 md:items-center">
          <div>
            <p class="text-brand-amber text-[11px] md:text-xs font-semibold tracking-[0.2em] uppercase mb-4">
              Partnership
            </p>
            <h2 class="text-3xl md:text-4xl font-bold leading-[1.12] tracking-[-0.03em] max-w-3xl">
              Built to work with your project team
            </h2>
            <p class="mt-5 text-base md:text-[17px] text-slate-400/95 max-w-2xl leading-[1.58]">
              We coordinate with builders, designers and homeowners to deliver clean electrical, lighting and
              smart-home infrastructure that supports the design intent, project schedule and long-term
              reliability of the home.
            </p>
          </div>
          <div class="mt-10 md:mt-0 flex justify-center md:justify-end shrink-0">
            <a
              href="/for-builders/"
              class="inline-flex min-h-[52px] items-center justify-center bg-brand-amber text-brand-navy font-semibold px-10 md:px-11 py-3.5 rounded-[2px] hover:bg-brand-amber-soft/95 transition-colors duration-500 text-sm whitespace-nowrap tracking-[0.03em] shadow-[0_4px_28px_rgba(198,165,94,0.12)]"
            >
              Talk to us about a project
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PhoneCTA />
</Layout>
