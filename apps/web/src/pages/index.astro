---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const moments = [
  { slug: 'bedroom', time: 'Before the day begins', title: 'Wake gently.', text: 'The room begins with softer light, allowing the day to arrive without urgency.' },
  { slug: 'kitchen', time: 'Through the day', title: 'Let the light follow life.', text: 'Breakfast, cooking and a quiet glass of water each ask something different of the same room.' },
  { slug: 'entry', time: 'Coming home', title: 'Feel welcomed, without asking.', text: 'The threshold responds naturally, making arrival feel familiar before a word is spoken.' },
  { slug: 'living', time: 'Evening', title: 'Let the home settle with you.', text: 'Family time, reading and film each find their own atmosphere as the day slows down.' },
];
---

<Layout
  title="Better Home Technology | Residential Experiences, Electrical & Lighting"
  description="A residential experience brand shaped around everyday life and delivered with professional electrical expertise in Adelaide."
>
  <Header />

  <main class="bg-[#f5f1ea] text-[#252823]">
    <!-- One promise. The homepage begins with belief, not products or services. -->
    <section class="relative min-h-[calc(100svh-5.5rem)] overflow-hidden bg-[#151a15] text-white">
      <img
        src="/front_page_background.jpg"
        alt=""
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="home-hero-image absolute inset-0 h-full w-full object-cover object-[62%_42%]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#151b16]/90 via-[#172018]/44 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#151b16]/38 via-transparent to-[#151b16]/10"></div>

      <div class="relative mx-auto flex min-h-[calc(100svh-5.5rem)] max-w-[1240px] items-center px-6 py-20 md:px-10 lg:px-14">
        <div class="max-w-[43rem]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d2b86f]">Better Home Philosophy</p>
          <h1 class="mt-7 max-w-[43rem] text-[clamp(3.35rem,7.2vw,6.8rem)] font-normal leading-[0.89] tracking-[-0.04em]" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Technology should quietly support everyday life.
          </h1>
          <p class="mt-8 max-w-[34rem] text-base leading-[1.75] text-white/75 md:text-lg">
            We design around the way a home feels — the light, comfort and small routines that shape an ordinary day.
          </p>
          <div class="mt-10">
            <a href="#philosophy" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#d2b86f] px-8 text-sm font-semibold text-[#151813] transition-colors hover:bg-[#dfc985]">
              Our approach
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Brand philosophy: fewer statements, more room. -->
    <section id="philosophy" class="relative scroll-mt-20 overflow-hidden border-b border-white/10 bg-[#293129] py-24 text-[#f3eee5] md:py-36">
      <picture class="pointer-events-none absolute inset-0 block" aria-hidden="true">
        <source srcset="/images/better-home/collections/away.webp" type="image/webp" />
        <img src="/images/better-home/collections/away.jpg" alt="" width="804" height="821" loading="lazy" class="home-philosophy-image h-full w-full object-cover object-[62%_50%] opacity-[0.16]" />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-[#293129]/72"></div>
      <div class="relative mx-auto max-w-[1120px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d0bd7b]">We begin with home</p>
        <h2 class="mt-7 max-w-[55rem] text-4xl font-normal leading-[1.03] tracking-[-0.025em] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Home is not a collection of devices. It is the way life unfolds between them.
        </h2>
        <div class="mt-16 grid gap-10 border-t border-white/15 pt-8 md:grid-cols-3 md:gap-14">
          <div>
            <p class="text-sm font-semibold text-[#d8dfd3]">Life comes first.</p>
            <p class="mt-3 text-[15px] leading-relaxed text-white/[0.62]">We begin with the way people arrive, gather, rest and leave — not with a list of devices.</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-[#d8dfd3]">Every room has a rhythm.</p>
            <p class="mt-3 text-[15px] leading-relaxed text-white/[0.62]">Morning, gathering, rest and return each ask something different of the same home.</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-[#d8dfd3]">Home should still feel like home.</p>
            <p class="mt-3 text-[15px] leading-relaxed text-white/[0.62]">Every response should feel natural, familiar and quietly personal.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- A day at home: moments first, products later. -->
    <section class="bg-[#5d665b] py-24 text-white md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d8c57e]">A day, quietly supported</p>
        <h2 class="mt-6 max-w-3xl text-5xl font-normal leading-[0.96] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          The small moments are the ones that make a home.
        </h2>

        <div class="mt-16 space-y-14 md:space-y-20">
          {moments.map((moment, index) => (
            <article class="grid gap-8 md:grid-cols-[1.2fr_0.8fr] md:items-center md:gap-14">
              <picture class={`relative block overflow-hidden rounded-[1.75rem] bg-[#30372f] ${index % 2 === 1 ? 'md:order-2' : ''}`}>
                <source srcset={`/images/better-home/collections/${moment.slug}.webp`} type="image/webp" />
                <img
                  src={`/images/better-home/collections/${moment.slug}.jpg`}
                  alt={`${moment.time} at home`}
                  width="804"
                  height="821"
                  loading="lazy"
                  decoding="async"
                  class="home-moment-image aspect-[4/3] h-full w-full object-cover"
                />
                <span class="pointer-events-none absolute inset-0 bg-[#465244]/[0.12] mix-blend-color"></span>
              </picture>
              <div class={index % 2 === 1 ? 'md:order-1' : ''}>
                <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#d8c57e]">{moment.time}</p>
                <h3 class="mt-3 text-4xl font-normal md:text-5xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">{moment.title}</h3>
                <p class="mt-4 max-w-md text-[15px] leading-relaxed text-white/70">{moment.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Meaning before mechanism. -->
    <section class="relative overflow-hidden bg-[#bcc4b6] py-24 text-[#283026] md:py-36">
      <picture class="pointer-events-none absolute inset-0 block" aria-hidden="true">
        <source srcset="/images/better-home/collections/living.webp" type="image/webp" />
        <img src="/images/better-home/collections/living.jpg" alt="" width="804" height="821" loading="lazy" class="h-full w-full object-cover object-center opacity-[0.11]" />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-[#d5dbcf]/72"></div>
      <div class="relative mx-auto max-w-[1040px] px-6 text-center md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#52604c]">A quieter kind of home</p>
        <h2 class="mx-auto mt-7 max-w-4xl text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Nothing asks for attention. Everything feels considered.
        </h2>
        <p class="mx-auto mt-8 max-w-2xl text-lg leading-[1.75] text-[#566052]">
          The home simply feels more comfortable, more intuitive and more like your own.
        </p>
      </div>
    </section>

    <!-- One graceful transition from philosophy into the Product System. -->
    <section class="bg-[#e8e5de] py-24 md:py-32">
      <div class="mx-auto grid max-w-[1160px] gap-12 px-6 md:grid-cols-[1.08fr_0.92fr] md:items-center md:px-10">
          <figure class="overflow-hidden rounded-[2rem] bg-[#d7d2c8]">
            <picture>
              <img src="/images/better-home/living-collection.png" alt="A calm, naturally lit residential living space" width="994" height="522" loading="lazy" class="home-transition-image aspect-[4/3] h-full w-full object-cover" />
            </picture>
          </figure>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">From a feeling to a clear system</p>
            <h2 class="mt-6 text-5xl font-normal leading-[1.02] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">Now shape Better Home around the way you live.</h2>
            <p class="mt-7 max-w-lg text-base leading-[1.75] text-[#686d65]">
              Begin with one Foundation. Choose the spaces that matter. Add only the experiences you value.
            </p>
            <a href="/better-home" class="mt-9 inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#52604c] px-9 text-sm font-semibold text-white transition-colors hover:bg-[#414d3c]">
              Discover Better Home
            </a>
          </div>
      </div>
    </section>

    <!-- A real home and a low-pressure next step turn interest into trust. -->
    <section class="bg-[#f5f1ea] py-24 md:py-32">
      <div class="mx-auto grid max-w-[1160px] overflow-hidden rounded-[2rem] bg-[#ded8cc] md:grid-cols-[0.92fr_1.08fr]">
        <figure class="relative min-h-[30rem] overflow-hidden bg-[#cbc4b7] md:min-h-[42rem]">
          <img
            src="/images/better-home/adelaide-residence-dining.jpg"
            alt="A completed residential dining space in Adelaide"
            width="1350"
            height="1800"
            loading="lazy"
            decoding="async"
            class="home-residence-image absolute inset-0 h-full w-full object-cover object-[50%_48%]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#20251f]/30 via-transparent to-transparent"></div>
          <figcaption class="absolute bottom-6 left-6 rounded-full bg-[#f6f1e8]/90 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#44503f] backdrop-blur-sm">
            Adelaide residence
          </figcaption>
        </figure>

        <div class="flex items-center px-7 py-14 md:px-16 md:py-20">
          <div class="max-w-[32rem]">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Designed around your home</p>
            <h2 class="mt-6 text-5xl font-normal leading-[1.01] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
              Every Better Home begins with a conversation.
            </h2>
            <p class="mt-7 text-base leading-[1.8] text-[#62685f]">
              Tell us about the rooms you use, the moments that matter and what you would like your home to do more naturally.
            </p>

            <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 border-y border-[#bbb4a7] py-5 text-[11px] font-semibold uppercase tracking-[0.16em] text-[#566150]">
              <span>Adelaide</span>
              <span>Design</span>
              <span>Installation</span>
              <span>Ongoing support</span>
            </div>

            <a href="/contact" class="mt-9 inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#52604c] px-9 text-sm font-semibold text-white transition-colors hover:bg-[#414d3c]">
              Start a conversation
            </a>
            <p class="mt-4 text-sm leading-relaxed text-[#777b73]">A relaxed first conversation. No technical preparation needed.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer minimal />
</Layout>

<style>
  .home-hero-image {
    filter: brightness(0.86) saturate(0.68) sepia(0.08) hue-rotate(-6deg);
  }

  .home-philosophy-image {
    filter: saturate(0.58) sepia(0.08) hue-rotate(-5deg);
  }

  .home-moment-image {
    filter: saturate(0.72) contrast(0.95) brightness(0.94) sepia(0.08);
  }

  .home-transition-image {
    filter: saturate(0.76) contrast(0.96) sepia(0.06);
  }

  .home-residence-image {
    filter: saturate(0.78) contrast(0.96) sepia(0.04);
  }
</style>
