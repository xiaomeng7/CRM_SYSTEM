---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
---

<Layout
  title="Better Home Technology | Residential Experiences, Electrical & Lighting"
  description="A residential experience brand shaped around everyday life and delivered with professional electrical expertise in Adelaide."
>
  <Header />

  <main class="bg-[#f5f1ea] text-[#252823]">
    <!-- One promise, one primary path. Professional delivery remains present but quiet. -->
    <section class="relative min-h-[calc(100svh-5.5rem)] overflow-hidden bg-[#111318] text-white">
      <img
        src="/front_page_background.jpg"
        alt=""
        width="1536"
        height="1024"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[62%_42%] brightness-[0.66] saturate-[0.76]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#101318]/95 via-[#101318]/65 to-[#101318]/15"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#101318]/65 via-transparent to-[#101318]/20"></div>

      <div class="relative mx-auto flex min-h-[calc(100svh-5.5rem)] max-w-[1240px] items-center px-6 py-20 md:px-10 lg:px-14">
        <div class="max-w-[43rem]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d2b86f]">Better Home</p>
          <h1 class="mt-7 max-w-[40rem] text-[clamp(3.8rem,8vw,7.4rem)] font-normal leading-[0.87] tracking-[-0.045em]" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            A better way to live at home.
          </h1>
          <p class="mt-8 max-w-[34rem] text-base leading-[1.75] text-white/75 md:text-lg">
            We believe a home should feel calm, intuitive and deeply personal. Technology should support that life quietly — without asking to be noticed.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-5">
            <a href="/better-home" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#d2b86f] px-8 text-sm font-semibold text-[#151813] transition-colors hover:bg-[#dfc985]">
              Explore Better Home
            </a>
            <a href="/for-builders/" class="text-sm font-medium text-white/65 underline decoration-white/25 underline-offset-8 transition-colors hover:text-white">
              For Builders &amp; Designers
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Brand philosophy: fewer statements, more room. -->
    <section class="border-b border-[#d9d3c9] bg-[#faf8f4] py-24 md:py-36">
      <div class="mx-auto max-w-[1120px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Designed around everyday life</p>
        <h2 class="mt-7 max-w-[55rem] text-4xl font-normal leading-[1.03] tracking-[-0.025em] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          A home should never feel like a showroom for technology.
        </h2>
        <div class="mt-16 grid gap-10 border-t border-[#cec8bd] pt-8 md:grid-cols-3 md:gap-14">
          <div>
            <p class="text-sm font-semibold text-[#52604c]">Life comes first.</p>
            <p class="mt-3 text-[15px] leading-relaxed text-[#686d65]">We begin with the way people arrive, gather, rest and leave — not with a list of devices.</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-[#52604c]">Technology becomes quiet.</p>
            <p class="mt-3 text-[15px] leading-relaxed text-[#686d65]">The best technology is felt in the comfort of the room, not noticed on the wall.</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-[#52604c]">Clarity builds trust.</p>
            <p class="mt-3 text-[15px] leading-relaxed text-[#686d65]">Every product has a defined experience, scope and path to professional installation.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial gateway only. The Better Home page owns the product system and Collection catalogue. -->
    <section class="py-24 md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <a href="/better-home" class="group relative block min-h-[38rem] overflow-hidden rounded-[2rem] bg-[#252a24] text-white md:min-h-[44rem]">
          <picture class="absolute inset-0 block">
            <source srcset="/images/better-home/collections/living.webp" type="image/webp" />
            <img
              src="/images/better-home/collections/living.jpg"
              alt="A calm Australian living space shaped by natural light"
              width="804"
              height="821"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-center transition duration-1000 ease-out group-hover:scale-[1.015]"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-r from-[#171a16]/90 via-[#171a16]/50 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#171a16]/65 via-transparent to-transparent"></div>
          <div class="relative flex min-h-[38rem] max-w-[42rem] flex-col justify-end p-8 md:min-h-[44rem] md:justify-center md:p-16">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d8c57e]">The Better Home system</p>
            <h2 class="mt-6 text-5xl font-normal leading-[0.94] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
              Begin with life, not technology.
            </h2>
            <p class="mt-7 max-w-lg text-base leading-[1.75] text-white/75 md:text-lg">
              A clear way to shape the rooms, comfort and everyday moments that matter to you.
            </p>
            <span class="mt-9 inline-flex w-fit items-center gap-3 border-b border-white/35 pb-2 text-sm font-medium text-white">
              Discover how Better Home works
              <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
      </div>
    </section>

    <!-- Technical capability is evidence of delivery, not the brand protagonist. -->
    <section class="bg-[#2f3730] py-24 text-white md:py-32">
      <div class="mx-auto grid max-w-[1160px] gap-14 px-6 md:grid-cols-[1.05fr_0.95fr] md:items-center md:px-10">
        <figure class="overflow-hidden rounded-[2rem] bg-[#1d231e]">
          <picture>
            <source srcset="/images/work-builder-wiring.webp" type="image/webp" />
            <img src="/images/work-builder-wiring.jpg" alt="Carefully coordinated residential electrical infrastructure" width="800" height="600" loading="lazy" class="aspect-[4/3] h-full w-full object-cover" />
          </picture>
        </figure>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#cbd5c2]">Designed clearly. Delivered properly.</p>
          <h2 class="mt-6 text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">One team, from idea to handover.</h2>
          <p class="mt-7 max-w-lg text-base leading-[1.75] text-white/68">
            Better Home is supported by licensed electrical installation, considered programming, testing and a clear customer handover.
          </p>
          <ul class="mt-9 grid gap-4 border-t border-white/15 pt-7 text-sm text-white/82 sm:grid-cols-2">
            <li>Residential experience design</li>
            <li>Licensed electrical installation</li>
            <li>Programming and commissioning</li>
            <li>Customer handover and support</li>
          </ul>
          <a href="/for-builders/" class="mt-9 inline-block text-sm font-medium text-[#d9c684] underline decoration-[#d9c684]/40 underline-offset-8">Professional delivery for project teams</a>
        </div>
      </div>
    </section>

    <!-- A single proof section instead of competing project grids. -->
    <section class="bg-[#faf8f4] py-24 md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <div class="grid gap-12 md:grid-cols-[1.2fr_0.8fr] md:items-end">
          <figure class="overflow-hidden rounded-[2rem] bg-[#ded7cb]">
            <picture>
              <source srcset="/images/work-living-room-led.webp" type="image/webp" />
              <img src="/images/work-living-room-led.jpg" alt="Residential living room with considered layered lighting" width="800" height="600" loading="lazy" class="aspect-[4/3] h-full w-full object-cover" />
            </picture>
          </figure>
          <div class="pb-2">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Selected residential work</p>
            <h2 class="mt-6 text-5xl font-normal leading-[1.02] md:text-6xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">Thoughtful light. Quiet control. A home that remains a home.</h2>
            <p class="mt-6 text-base leading-[1.75] text-[#686d65]">Our work brings electrical infrastructure, lighting and residential systems together without competing with the architecture.</p>
            <a href="/projects" class="mt-8 inline-block text-sm font-medium text-[#52604c] underline decoration-[#8f9989] underline-offset-8">View selected work</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust and action, once. -->
    <section class="border-t border-[#d9d3c9] bg-[#e8e3d9] py-20 md:py-24">
      <div class="mx-auto max-w-[1120px] px-6 md:px-10">
        <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Begin with a conversation</p>
            <h2 class="mt-5 max-w-3xl text-5xl font-normal leading-[1.02] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">Tell us how you want your home to feel.</h2>
            <p class="mt-6 text-sm leading-relaxed text-[#686d65]">Licensed PGE275430 · 5.0 Google Rating · 3-Year Workmanship Warranty</p>
          </div>
          <a href="/contact" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#52604c] px-9 text-sm font-semibold text-white transition-colors hover:bg-[#414d3c]">Start a conversation</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PhoneCTA />
</Layout>
