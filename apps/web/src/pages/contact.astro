---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const channels = [
  {
    eyebrow: 'Call',
    title: '0410 323 034',
    body: 'The most direct way to begin. Monday to Friday, 8am–5pm.',
    href: 'tel:0410323034',
    cta: 'Call Meng',
  },
  {
    eyebrow: 'Write',
    title: 'Info@bhtechnology.com.au',
    body: 'Share a few thoughts, a floor plan or simply the room you would like to begin with.',
    href: 'mailto:Info@bhtechnology.com.au?subject=Better%20Home%20conversation',
    cta: 'Start an email',
  },
];
---

<Layout
  title="Start a Conversation | Better Home Technology"
  description="Tell us about your home, the rooms you use and the everyday moments you would like to make more natural."
>
  <Header />

  <main class="bg-[#f5f1ea] text-[#252823]">
    <section class="relative min-h-[42rem] overflow-hidden bg-[#283028] text-[#f5f1e9]">
      <img
        src="/images/better-home/adelaide-residence-dining.jpg"
        alt=""
        width="1350"
        height="1800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[50%_45%] opacity-[0.28]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#252d25] via-[#252d25]/90 to-[#252d25]/45"></div>

      <div class="relative mx-auto flex min-h-[42rem] max-w-[1160px] items-center px-6 py-24 md:px-10 md:py-32">
        <div class="max-w-[47rem]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d4c27e]">Start a conversation</p>
          <h1 class="mt-7 text-[clamp(3.5rem,7.4vw,7rem)] font-normal leading-[0.9] tracking-[-0.035em]" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Tell us how you would like your home to feel.
          </h1>
          <p class="mt-8 max-w-[35rem] text-base leading-[1.8] text-white/70 md:text-lg">
            You do not need a technical brief. Begin with a room, a routine or a moment at home that could feel more natural.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#e8e5de] py-24 md:py-32">
      <div class="mx-auto grid max-w-[1160px] gap-14 px-6 md:grid-cols-[0.8fr_1.2fr] md:px-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">A relaxed first step</p>
          <h2 class="mt-6 text-5xl font-normal leading-[1.02] md:text-6xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            A conversation before a solution.
          </h2>
          <p class="mt-7 max-w-md text-base leading-[1.8] text-[#686d65]">
            We will listen first, then help you find a clear place to begin — whether that is one room, a complete home or a future project.
          </p>

          <dl class="mt-10 space-y-5 border-t border-[#c8c1b5] pt-7 text-sm">
            <div class="flex gap-5">
              <dt class="w-24 shrink-0 font-semibold text-[#465241]">Based in</dt>
              <dd class="leading-relaxed text-[#6c7169]">Mawson Lakes, serving metropolitan Adelaide</dd>
            </div>
            <div class="flex gap-5">
              <dt class="w-24 shrink-0 font-semibold text-[#465241]">Response</dt>
              <dd class="leading-relaxed text-[#6c7169]">Usually within one business day</dd>
            </div>
            <div class="flex gap-5">
              <dt class="w-24 shrink-0 font-semibold text-[#465241]">Bring</dt>
              <dd class="leading-relaxed text-[#6c7169]">Nothing more than an idea of what matters to you</dd>
            </div>
          </dl>
        </div>

        <div class="grid gap-5">
          {channels.map((channel, index) => (
            <a
              href={channel.href}
              class:list={[
                'group flex min-h-[15rem] flex-col justify-between rounded-[1.75rem] border p-8 transition-all duration-500 md:p-10',
                index === 0
                  ? 'border-[#52604c] bg-[#52604c] text-white hover:bg-[#465440]'
                  : 'border-[#c8c1b5] bg-[#f5f1ea] text-[#2c302b] hover:border-[#8f9988]'
              ]}
            >
              <div>
                <p class:list={['text-[10px] font-semibold uppercase tracking-[0.2em]', index === 0 ? 'text-[#d8c57e]' : 'text-[#65755d]']}>{channel.eyebrow}</p>
                <h3 class="mt-5 break-words text-3xl font-normal leading-tight md:text-4xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">{channel.title}</h3>
                <p class:list={['mt-4 max-w-lg text-[15px] leading-[1.75]', index === 0 ? 'text-white/65' : 'text-[#70756d]']}>{channel.body}</p>
              </div>
              <p class:list={['mt-8 text-sm font-semibold', index === 0 ? 'text-[#e1ce8a]' : 'text-[#52604c]']}>{channel.cta} <span aria-hidden="true">→</span></p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#bcc4b6] py-20 text-[#2d352b] md:py-24">
      <div class="mx-auto max-w-[900px] px-6 text-center md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#566350]">Wherever you begin</p>
        <p class="mx-auto mt-6 max-w-3xl text-4xl font-normal leading-[1.08] md:text-6xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          The first decision does not need to be a large one. It only needs to make home feel better.
        </p>
      </div>
    </section>
  </main>

  <Footer minimal />
</Layout>
