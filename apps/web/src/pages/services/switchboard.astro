---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';

const deliverables = [
  'Switchboard capacity review against current and planned electrical load.',
  'RCD and RCBO protection strategy for safer circuit separation.',
  'Upgrade planning for older boards before renovation, EV charging, or solar changes.',
  'Risk-first assessment for aged enclosures, deteriorated internals, and wiring condition.',
  'Forward planning for future load growth instead of repeated patch upgrades.',
];

const suitableFor = [
  'Older Adelaide homes with legacy boards and unclear circuit history.',
  'Renovation projects that need additional circuits and better load distribution.',
  'Properties preparing for EV charger, electric hot water, or future solar and battery.',
];

const process = [
  { n: '01', title: 'On-site board assessment', body: 'We inspect existing board condition, accessible circuits, and practical upgrade constraints.' },
  { n: '02', title: 'Load and protection plan', body: 'We define capacity, circuit grouping, and protection approach based on current and future usage.' },
  { n: '03', title: 'Upgrade execution', body: 'Board and associated infrastructure are upgraded with clear circuit structure and labelled outcomes.' },
  { n: '04', title: 'Handover guidance', body: 'You receive a plain-language summary of what changed and how future additions should be staged.' },
];
---

<Layout
  title="Switchboard Upgrades — Better Home Technology | Adelaide"
  description="Switchboard and capacity upgrades for Adelaide homes, renovations, and future EV or solar readiness with assessment-first planning."
>
  <Header />

  <main>
    <section class="bg-brand-navy text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-brand-hero-gradient pointer-events-none"></div>
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots"></div>
      <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.25em] uppercase mb-6">
          Switchboard upgrades
        </p>
        <h1 class="text-5xl md:text-6xl font-bold leading-[1.05] tracking-tight max-w-4xl">
          Your switchboard defines what your home can safely support
          <span class="text-brand-amber"> now and next.</span>
        </h1>
        <p class="mt-8 text-xl md:text-2xl text-slate-300 max-w-3xl leading-relaxed">
          We assess board capacity, protection layout, and upgrade path for older homes, renovations, and
          properties planning EV, electrification, or future energy systems in Adelaide.
        </p>
      </div>
    </section>

    <section class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Why it matters
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-6">
          Load demand is rising faster than legacy boards were designed for.
        </h2>
        <p class="text-lg text-brand-muted leading-relaxed max-w-4xl">
          Air conditioning, induction cooking, EV charging, and electric hot water all increase peak demand.
          Older switchboards can run out of usable capacity or protection flexibility. Some properties also
          carry extra planning constraints around older installation materials, so assessment comes first.
        </p>
      </div>
    </section>

    <section class="bg-brand-surface-alt py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          What we do
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-10">
          Capacity-led switchboard planning and upgrade delivery.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {deliverables.map((item) => (
            <div class="bg-white rounded-xl p-7 border border-slate-200">
              <p class="text-brand-ink leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Suitable for
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-10">
          Properties where electrical demand is changing.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {suitableFor.map((item) => (
            <div class="border-l-4 border-brand-amber pl-5">
              <p class="text-brand-ink leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-brand-surface-alt py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Process
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-12">
          Four steps to a clearer, safer electrical backbone.
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {process.map((step) => (
            <div class="bg-white rounded-xl p-6 border border-slate-200">
              <p class="text-brand-amber font-mono text-2xl font-bold mb-3">{step.n}</p>
              <h3 class="text-lg font-bold text-brand-ink mb-2">{step.title}</h3>
              <p class="text-brand-muted text-sm leading-relaxed">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-brand-navy text-white py-20 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots-soft"></div>
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-6">
          Next step
        </p>
        <p class="text-3xl md:text-5xl font-bold leading-tight">
          Need to understand your board before upgrading?
        </p>
        <p class="mt-8 text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Contact us for a switchboard assessment. We will map practical options based on the property, load
          profile, and upgrade timeline.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="bg-brand-amber text-brand-navy font-semibold px-8 py-4 rounded-md hover:bg-brand-amber-soft transition">
            Request switchboard assessment
          </a>
          <a href="tel:0410323034" class="border-2 border-white text-white font-semibold px-8 py-4 rounded-md hover:bg-white/10 transition">
            Call 0410 323 034
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PhoneCTA />
</Layout>
