---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';

const deliverables = [
  'CCTV camera placement based on real entry points, blind spots, and evidence capture angles.',
  'Intercom integration for front gate, main door, and remote unlock workflows.',
  'Remote viewing setup with secure user access and practical handover for day-to-day use.',
  'Network setup for stable streams, reliable recorder communication, and clean cable routing.',
  'NVR and storage design based on retention window, camera count, and playback expectations.',
];

const suitableFor = [
  'Homeowners who want usable footage and reliable remote access, not decorative cameras.',
  'Small commercial operators needing clear entrances, loading areas, and after-hours visibility.',
  'Builders delivering premium handover with documented camera, intercom, and app readiness.',
];

const process = [
  { n: '01', title: 'Site risk mapping', body: 'We identify vulnerable approaches, lighting conditions, and required evidence zones before placement.' },
  { n: '02', title: 'System architecture', body: 'We define camera type, intercom points, network topology, and recorder capacity.' },
  { n: '03', title: 'Install and configure', body: 'Devices are mounted, cabled, and tuned for recording quality, alerts, and remote access stability.' },
  { n: '04', title: 'Handover and verification', body: 'You receive app access, recorder guidance, and practical checks for playback and incident review.' },
];
---

<Layout
  title="CCTV & Security Systems — Better Home Technology | Adelaide"
  description="CCTV and security systems for Adelaide homes, builders, and small commercial sites with camera placement strategy, network stability, and remote access."
>
  <Header />

  <main>
    <section class="bg-brand-navy text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-brand-hero-gradient pointer-events-none"></div>
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots"></div>
      <div class="relative mx-auto max-w-6xl px-6 py-20 md:py-28">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.25em] uppercase mb-6">
          CCTV & security
        </p>
        <h1 class="text-5xl md:text-6xl font-bold leading-[1.05] tracking-tight max-w-4xl">
          Security systems are only useful when footage is
          <span class="text-brand-amber"> clear, stable, and retrievable.</span>
        </h1>
        <p class="mt-8 text-xl md:text-2xl text-slate-300 max-w-3xl leading-relaxed">
          We design CCTV and intercom systems for Adelaide homes, small business sites, and builder handovers
          with reliable recording and secure remote access.
        </p>
      </div>
    </section>

    <section class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Why it matters
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-6">
          Most camera complaints come from design mistakes, not hardware.
        </h2>
        <p class="text-lg text-brand-muted leading-relaxed max-w-4xl">
          Blind angles, weak Wi-Fi links, poor night positioning, and undersized storage create the common
          “camera is installed but unusable” outcome. We start from placement and network stability so the
          system works when you need to review an incident.
        </p>
      </div>
    </section>

    <section class="bg-brand-surface-alt py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          What we do
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-10">
          CCTV, intercom, network, and recording built as one system.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {deliverables.map((item) => (
            <div class="bg-white rounded-xl p-7 border border-slate-200">
              <p class="text-brand-ink leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Suitable for
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-10">
          Projects where coverage quality matters more than camera count.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {suitableFor.map((item) => (
            <div class="border-l-4 border-brand-amber pl-5">
              <p class="text-brand-ink leading-relaxed">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-brand-surface-alt py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Process
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-12">
          Four steps from survey to reliable remote viewing.
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {process.map((step) => (
            <div class="bg-white rounded-xl p-6 border border-slate-200">
              <p class="text-brand-amber font-mono text-2xl font-bold mb-3">{step.n}</p>
              <h3 class="text-lg font-bold text-brand-ink mb-2">{step.title}</h3>
              <p class="text-brand-muted text-sm leading-relaxed">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-brand-navy text-white py-20 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots-soft"></div>
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-6">
          Next step
        </p>
        <p class="text-3xl md:text-5xl font-bold leading-tight">
          Planning CCTV or intercom for your property?
        </p>
        <p class="mt-8 text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Share the property type and target areas. We will advise the right coverage and recording setup
          before installation starts.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="bg-brand-amber text-brand-navy font-semibold px-8 py-4 rounded-md hover:bg-brand-amber-soft transition">
            Request CCTV assessment
          </a>
          <a href="tel:0410323034" class="border-2 border-white text-white font-semibold px-8 py-4 rounded-md hover:bg-white/10 transition">
            Call 0410 323 034
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PhoneCTA />
</Layout>
