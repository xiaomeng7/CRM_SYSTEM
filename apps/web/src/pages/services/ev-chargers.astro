---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const designQuestions = [
  ['How the car is used', 'Daily distance, time at home and the charging window matter more than choosing the largest available charger.'],
  ['Where the car rests', 'Garage, carport and driveway layouts shape the cable route, mounting position and how natural charging feels each day.'],
  ['What the home can support', 'Switchboard condition, available capacity and other household loads determine the appropriate electrical pathway.'],
  ['What may change later', 'Solar, batteries, a second vehicle and broader electrification are easier to accommodate when considered early.'],
];

const pathways = [
  {
    title: 'An existing home',
    body: 'Assess the switchboard and practical cable route before selecting equipment or committing to an installation date.',
  },
  {
    title: 'A new build or renovation',
    body: 'Reserve capacity and install the right pathway while walls, ceilings and external works are still coordinated.',
  },
  {
    title: 'A staged energy plan',
    body: 'Prepare for later solar, batteries or a second EV without paying for every future component today.',
  },
];

const process = [
  ['01', 'Understand', 'Review vehicle use, parking, the existing electrical installation and likely future energy changes.'],
  ['02', 'Design', 'Define charger capacity, protection, cable route and any enabling switchboard work.'],
  ['03', 'Install', 'Complete the agreed electrical work, mount the equipment and commission the charging setup.'],
  ['04', 'Settle into use', 'Explain charging schedules, everyday operation and what to consider before future expansion.'],
];
---

<Layout
  title="Home EV Charger Assessment & Installation Adelaide"
  description="Home EV charging designed around switchboard capacity, parking layout, daily vehicle use and future residential energy plans."
>
  <Header />

  <main class="bg-[#f5f1ea] text-[#252823]">
    <section class="relative min-h-[calc(100svh-5.5rem)] overflow-hidden bg-[#202620] text-[#f5f1e9]">
      <picture class="absolute inset-0 block">
        <source srcset="/images/work-exterior-night.webp" type="image/webp" />
        <img
          src="/images/work-exterior-night.jpg"
          alt=""
          width="800"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-center opacity-[0.53]"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-r from-[#1e251e]/96 via-[#1e251e]/76 to-[#1e251e]/28"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#1e251e]/58 via-transparent to-[#1e251e]/15"></div>

      <div class="relative mx-auto flex min-h-[calc(100svh-5.5rem)] max-w-[1160px] items-center px-6 py-24 md:px-10">
        <div class="max-w-[52rem]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d5c17b]">EV charging at home</p>
          <h1 class="mt-7 text-[clamp(3.5rem,7.2vw,7rem)] font-normal leading-[0.9] tracking-[-0.04em]" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Let the car charge while home is at rest.
          </h1>
          <p class="mt-8 max-w-[39rem] text-base leading-[1.8] text-white/72 md:text-lg">
            Home EV charging designed around the vehicle, the parking space and the electrical capacity already supporting everyday life.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#e8e5de] py-24 md:py-36">
      <div class="mx-auto grid max-w-[1080px] gap-12 px-6 md:grid-cols-[0.7fr_1.3fr] md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">A residential decision</p>
        <div>
          <h2 class="text-5xl font-normal leading-[1.01] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            The right charger begins with the home, not the box on the wall.
          </h2>
          <p class="mt-8 max-w-[44rem] text-base leading-[1.85] text-[#666c63]">
            Reliable charging depends on more than hardware. The household load, switchboard, cable route, parking position and time available each night all influence what should be installed.
          </p>
          <p class="mt-6 max-w-[44rem] text-base leading-[1.85] text-[#666c63]">
            By assessing these first, we can avoid unnecessary capacity, awkward installation decisions and upgrades that need to be repeated when the home’s energy use changes.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#596458] py-24 text-white md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d8c57e]">What shapes the design</p>
        <h2 class="mt-6 max-w-[49rem] text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Four questions before choosing equipment.
        </h2>
        <div class="mt-16 grid border-t border-white/15 md:grid-cols-2">
          {designQuestions.map(([title, body], index) => (
            <article class:list={[
              'border-b border-white/15 py-9 md:min-h-[17rem] md:p-10',
              index % 2 === 0 ? 'md:border-r' : '',
            ]}>
              <h3 class="text-3xl font-normal md:text-4xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">{title}</h3>
              <p class="mt-5 max-w-md text-[15px] leading-[1.8] text-white/62">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#f5f1ea] py-24 md:py-32">
      <div class="mx-auto grid max-w-[1160px] gap-14 px-6 md:grid-cols-[1.05fr_0.95fr] md:items-center md:px-10">
        <figure class="overflow-hidden rounded-[2rem] bg-[#d4cec2]">
          <picture>
            <source srcset="/images/work-cable-management.webp" type="image/webp" />
            <img
              src="/images/work-cable-management.jpg"
              alt="Carefully planned electrical cabling and containment"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] h-full w-full object-cover"
            />
          </picture>
        </figure>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Infrastructure first</p>
          <h2 class="mt-6 text-5xl font-normal leading-[1.02] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            The quiet convenience depends on what sits behind it.
          </h2>
          <p class="mt-7 max-w-lg text-base leading-[1.8] text-[#686d65]">
            The most successful installation is the one that becomes an ordinary part of arriving home: park, connect and let the charging schedule work in the background.
          </p>
          <p class="mt-6 max-w-lg text-base leading-[1.8] text-[#686d65]">
            That simplicity is supported by appropriate protection, an intentional route and commissioning that reflects the household’s actual routine.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#d7ddd1] py-24 md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#596754]">Three pathways</p>
        <h2 class="mt-6 max-w-[47rem] text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Install now, prepare early or stage the future.
        </h2>
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {pathways.map((pathway) => (
            <article class="rounded-[1.5rem] border border-[#aeb8a7] bg-[#eef0ea]/45 p-8 md:min-h-[17rem]">
              <h3 class="text-3xl font-normal leading-[1.08]" style="font-family: 'Cormorant Garamond', Georgia, serif;">{pathway.title}</h3>
              <p class="mt-5 text-[15px] leading-[1.8] text-[#667061]">{pathway.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#e8e5de] py-24 md:py-32">
      <div class="mx-auto max-w-[1080px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">From assessment to first charge</p>
        <h2 class="mt-6 max-w-[47rem] text-5xl font-normal leading-[1.01] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Four steps to a natural daily routine.
        </h2>
        <div class="mt-16 border-t border-[#c9c2b6]">
          {process.map(([number, title, body]) => (
            <article class="grid gap-5 border-b border-[#c9c2b6] py-8 md:grid-cols-[0.18fr_0.52fr_1.3fr] md:items-start md:gap-8">
              <p class="text-[10px] font-semibold tracking-[0.2em] text-[#788471]">{number}</p>
              <h3 class="text-2xl font-normal text-[#333932] md:text-3xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">{title}</h3>
              <p class="max-w-2xl text-[15px] leading-[1.75] text-[#6c7169]">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#293129] py-24 text-[#f3eee5] md:py-32">
      <div class="mx-auto max-w-[900px] px-6 text-center md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d0bd7b]">Begin with readiness</p>
        <h2 class="mx-auto mt-7 max-w-3xl text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Tell us about the car, the parking space and the home.
        </h2>
        <p class="mx-auto mt-7 max-w-xl text-base leading-[1.8] text-white/62">
          A switchboard photograph and a few images of the proposed charging location are enough to begin.
        </p>
        <a href="/contact" class="mt-9 inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#d2b86f] px-9 text-sm font-semibold text-[#1f261f] transition-colors hover:bg-[#dfc985]">
          Request an EV charging assessment
        </a>
      </div>
    </section>
  </main>

  <Footer minimal />
</Layout>
