---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Your Better Home selection is with us" description="Better Home will review your selection and confirm the next step with you.">
  <Header />
  <main class="min-h-[70vh] bg-[#f5f1ea] text-[#252823]">
    <section class="mx-auto grid max-w-[1160px] gap-12 px-6 py-20 md:grid-cols-[1.1fr_0.9fr] md:items-center md:px-10 md:py-28">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">Selection received</p>
        <h1 class="mt-6 font-['Cormorant_Garamond',Georgia,serif] text-[clamp(3.6rem,7vw,6.5rem)] font-normal leading-[0.92] tracking-[-0.04em]">Your home is beginning to take shape.</h1>
        <p id="thank-you-name" class="mt-8 max-w-2xl text-lg leading-relaxed text-[#646b61]">Thank you. Your Better Home selection is now with our team.</p>
      </div>
      <aside class="rounded-3xl bg-[#30372f] p-8 text-white md:p-10">
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#c6d0bd]">What happens next</p>
        <ol class="mt-7 space-y-7">
          <li class="flex gap-5"><span class="text-[#c6d0bd]">01</span><div><h2 class="font-['Cormorant_Garamond',Georgia,serif] text-2xl font-normal">We review the selection.</h2><p class="mt-2 text-sm leading-relaxed text-[#cbd2c6]">We check product relationships, standard scope and anything you have told us.</p></div></li>
          <li class="flex gap-5"><span class="text-[#c6d0bd]">02</span><div><h2 class="font-['Cormorant_Garamond',Georgia,serif] text-2xl font-normal">We confirm the home.</h2><p class="mt-2 text-sm leading-relaxed text-[#cbd2c6]">A short conversation or site review confirms conditions that an online estimate cannot see.</p></div></li>
          <li class="flex gap-5"><span class="text-[#c6d0bd]">03</span><div><h2 class="font-['Cormorant_Garamond',Georgia,serif] text-2xl font-normal">You receive a formal proposal.</h2><p class="mt-2 text-sm leading-relaxed text-[#cbd2c6]">The final scope, investment and next step are presented clearly before you decide.</p></div></li>
        </ol>
        <div class="mt-8 border-t border-white/15 pt-6">
          <p class="text-xs leading-relaxed text-[#cbd2c6]">Need to add something now?</p>
          <a href="tel:0410323034" class="mt-2 inline-block text-lg text-white">0410 323 034</a>
        </div>
      </aside>
    </section>
    <section class="border-t border-[#d9d3c9] bg-[#faf8f4] py-12">
      <div class="mx-auto flex max-w-[1160px] flex-wrap gap-4 px-6 md:px-10">
        <a href="/better-home" class="inline-flex min-h-12 items-center rounded-full bg-[#65755d] px-7 text-sm font-semibold text-white">Explore products</a>
        <a href="/" class="inline-flex min-h-12 items-center rounded-full border border-[#bbb6ac] px-7 text-sm font-medium">Return home</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  try {
    const submission = JSON.parse(sessionStorage.getItem('betterHomeSubmission') || '{}');
    const greeting = document.getElementById('thank-you-name');
    if (greeting && submission.name) greeting.textContent = `Thank you, ${submission.name}. Your Better Home selection is now with our team.`;
    if (typeof window.bhtTrack === 'function') window.bhtTrack('selection_received', {
      currency: 'AUD',
      value: Number(submission.estimatedTotal || 0),
    });
    sessionStorage.removeItem('betterHomeSubmission');
  } catch {}
</script>
