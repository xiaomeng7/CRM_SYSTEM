---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const principles = [
  {
    number: '01',
    title: 'Listen before designing.',
    body: 'We begin with the people, rooms and routines that shape the home. The system follows from there.',
  },
  {
    number: '02',
    title: 'Resolve it before site.',
    body: 'Lighting, electrical capacity and infrastructure are considered early, while drawings are still flexible.',
  },
  {
    number: '03',
    title: 'Make complexity feel simple.',
    body: 'Careful specification and programming belong behind the scenes. At home, the result should feel natural.',
  },
  {
    number: '04',
    title: 'Stay for the long term.',
    body: 'Clear documentation, familiar people and ongoing support make the home easier to live with after handover.',
  },
];

const credentials = [
  ['Company', 'Better Home Technology Pty Ltd'],
  ['Electrical Contractor Licence', 'PGE275430'],
  ['ABN', '56 613 514 640'],
  ['Coverage', 'Public Liability + Workers Compensation'],
  ['Workmanship Warranty', '3 years on our installation work'],
  ['Based in', 'Mawson Lakes, South Australia'],
];
---

<Layout
  title="About Better Home Technology | Residential Design & Electrical Delivery"
  description="Better Home brings residential experience design together with licensed electrical delivery in Adelaide."
>
  <Header />

  <main class="bg-[#f5f1ea] text-[#252823]">
    <section class="relative min-h-[calc(100svh-5.5rem)] overflow-hidden bg-[#202620] text-[#f5f1e9]">
      <img
        src="/images/better-home/adelaide-residence-dining.jpg"
        alt=""
        width="1350"
        height="1800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[50%_47%] opacity-[0.42]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1f261f]/95 via-[#1f261f]/76 to-[#1f261f]/25"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#1f261f]/55 via-transparent to-[#1f261f]/15"></div>

      <div class="relative mx-auto flex min-h-[calc(100svh-5.5rem)] max-w-[1160px] items-center px-6 py-24 md:px-10">
        <div class="max-w-[50rem]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d5c17b]">About Better Home</p>
          <h1 class="mt-7 text-[clamp(3.5rem,7.4vw,7.2rem)] font-normal leading-[0.89] tracking-[-0.04em]" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Designed with feeling. Delivered with discipline.
          </h1>
          <p class="mt-8 max-w-[36rem] text-base leading-[1.8] text-white/70 md:text-lg">
            We bring the sensitivity of residential design together with the responsibility of licensed electrical delivery.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#e8e5de] py-24 md:py-36">
      <div class="mx-auto grid max-w-[1080px] gap-12 px-6 md:grid-cols-[0.72fr_1.28fr] md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Why we exist</p>
        <div>
          <h2 class="text-5xl font-normal leading-[1.02] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            A better home needs more than good technology.
          </h2>
          <div class="mt-9 max-w-[43rem] space-y-6 text-base leading-[1.85] text-[#666c63]">
            <p>
              It needs someone to understand how the space will be lived in — and someone who can make that idea work safely, quietly and reliably.
            </p>
            <p>
              Better Home was formed to bring those two responsibilities together. We work with homeowners, builders and designers before decisions become expensive to change.
            </p>
            <p>
              The result is not a house full of visible technology. It is a home whose light, comfort and everyday responses feel considered from the beginning.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#596458] py-24 text-white md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d8c57e]">How we work</p>
        <h2 class="mt-6 max-w-[48rem] text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Thoughtful before site. Quiet after handover.
        </h2>

        <div class="mt-16 grid border-t border-white/15 md:grid-cols-2">
          {principles.map((principle, index) => (
            <article class:list={[
              'border-b border-white/15 py-9 md:min-h-[18rem] md:p-10',
              index % 2 === 0 ? 'md:border-r' : '',
            ]}>
              <p class="text-[10px] font-semibold tracking-[0.2em] text-[#d8c57e]">{principle.number}</p>
              <h3 class="mt-8 text-3xl font-normal md:text-4xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">{principle.title}</h3>
              <p class="mt-4 max-w-md text-[15px] leading-[1.8] text-white/62">{principle.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#f5f1ea] py-24 md:py-32">
      <div class="mx-auto grid max-w-[1160px] gap-14 px-6 md:grid-cols-[1fr_1fr] md:items-center md:px-10">
        <figure class="overflow-hidden rounded-[2rem] bg-[#d4cec2]">
          <picture>
            <source srcset="/images/better-home/collections/living.webp" type="image/webp" />
            <img
              src="/images/better-home/collections/living.jpg"
              alt="A calm residential living space"
              width="804"
              height="821"
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] h-full w-full object-cover"
            />
          </picture>
        </figure>

        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Design and delivery</p>
          <h2 class="mt-6 text-5xl font-normal leading-[1.02] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            One idea, carried all the way through.
          </h2>
          <p class="mt-7 max-w-lg text-base leading-[1.8] text-[#686d65]">
            We coordinate electrical, lighting and residential technology as one system — from early advice and specification to installation, programming, handover and support.
          </p>
          <p class="mt-6 max-w-lg text-base leading-[1.8] text-[#686d65]">
            The people who understand the intent remain close to the work. That continuity protects both the design and the finished home.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#d7ddd1] py-24 md:py-28">
      <div class="mx-auto max-w-[1080px] px-6 md:px-10">
        <div class="grid gap-8 md:grid-cols-[0.7fr_1.3fr]">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#596754]">Professional foundation</p>
            <h2 class="mt-6 text-4xl font-normal leading-[1.05] md:text-6xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
              The quiet confidence behind the work.
            </h2>
          </div>
          <dl class="grid gap-x-10 sm:grid-cols-2">
            {credentials.map(([label, value]) => (
              <div class="border-t border-[#aeb8a7] py-6">
                <dt class="text-[10px] font-semibold uppercase tracking-[0.17em] text-[#65705f]">{label}</dt>
                <dd class="mt-3 text-[15px] leading-relaxed text-[#343b32]">{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="bg-[#293129] py-24 text-[#f3eee5] md:py-32">
      <div class="mx-auto max-w-[900px] px-6 text-center md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d0bd7b]">Begin with a conversation</p>
        <h2 class="mx-auto mt-7 max-w-3xl text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Tell us what matters at home.
        </h2>
        <p class="mx-auto mt-7 max-w-xl text-base leading-[1.8] text-white/62">
          We will help you find a clear, considered place to begin.
        </p>
        <a href="/contact" class="mt-9 inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#d2b86f] px-9 text-sm font-semibold text-[#1f261f] transition-colors hover:bg-[#dfc985]">
          Start a conversation
        </a>
      </div>
    </section>
  </main>

  <Footer minimal />
</Layout>
