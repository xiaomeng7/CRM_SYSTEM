---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneCTA from '../components/PhoneCTA.astro';

const principles = [
  {
    title: 'Independent. Honest. In writing.',
    body: "We're paid for advice and workmanship — not commission. If we don't think a job should happen, we say so. In writing.",
  },
  {
    title: 'Specified. Not improvised.',
    body: 'Every job — from a single switchboard upgrade to a full luxury build — starts with a documented spec. No "we\'ll figure it out on site" surprises.',
  },
  {
    title: 'On time, every time.',
    body: 'Locked timeframes. Daily progress reports. If we cause a delay, the cost is on us — in writing.',
  },
  {
    title: 'Same crew, every visit.',
    body: "We don't subcontract. The electrician you meet at quote is the one on site at handover.",
  },
];
---

<Layout
  title="About — Better Home Technology | Adelaide Smart Home & Premium Electrical"
  description="Mawson Lakes-based licensed electricians serving Adelaide homes and luxury custom builders. Independent, honest, in writing."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-brand-navy text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-brand-hero-gradient pointer-events-none"></div>
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots"></div>
      <div class="relative mx-auto max-w-4xl px-6 py-20 md:py-28">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.25em] uppercase mb-6">
          About Better Home Technology
        </p>
        <h1 class="text-5xl md:text-6xl font-bold leading-[1.05] tracking-tight">
          Adelaide's smart home<br class="hidden md:inline" />
          <span class="text-brand-amber">and premium electrical specialists.</span>
        </h1>
        <p class="mt-8 text-xl md:text-2xl text-slate-300 max-w-2xl leading-relaxed">
          Licensed electricians (PGE275430) based in Mawson Lakes, serving Adelaide homes and
          luxury custom builders. Independent, honest, in writing.
        </p>
      </div>
    </section>

    <!-- What we do -->
    <section class="bg-white py-20 md:py-28">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          What we do
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-8">
          Three lanes. One brand.
        </h2>
        <div class="space-y-8 text-lg text-brand-ink leading-relaxed">
          <p>
            <strong class="text-brand-navy">Pre-purchase electrical inspections</strong> for
            Adelaide property buyers — booked in 3 days, written report within 48 hours of
            the site visit, $495 fixed. The independent verdict you want before you sign.
          </p>
          <p>
            <strong class="text-brand-navy">Smart home and premium electrical</strong> for
            new luxury builds — designed at blueprint stage, wired during 1st fix,
            commissioned before handover. We work directly with builders, architects, and
            interior designers from Adelaide's custom-build segment.
          </p>
          <p>
            <strong class="text-brand-navy">Established home upgrades</strong> — switchboard
            modernisation, EV chargers, CCTV and security, smart home retrofits. Same
            licensed crew, fixed pricing, 3-year workmanship warranty on every install.
          </p>
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section class="bg-brand-surface-alt py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          What we stand for
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-12">
          Four principles every customer sees in writing.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {principles.map((p) => (
            <div class="bg-white rounded-xl p-8 border-l-4 border-brand-amber">
              <h3 class="text-xl font-bold text-brand-ink mb-3">{p.title}</h3>
              <p class="text-base text-brand-muted leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Credentials -->
    <section class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Credentials
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-10">
          Licensed, insured, on the books.
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-base">
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Company</dt>
            <dd class="font-bold text-brand-ink">Better Home Technology Pty Ltd</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">ABN</dt>
            <dd class="font-bold text-brand-ink">56 613 514 640</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Electrical Contractor Licence</dt>
            <dd class="font-bold text-brand-ink">PGE275430</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Coverage</dt>
            <dd class="font-bold text-brand-ink">Public Liability + Workers Compensation</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Workmanship Warranty</dt>
            <dd class="font-bold text-brand-ink">3 years on every install</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Office</dt>
            <dd class="font-bold text-brand-ink">Level 3, 1-3 Metro Parade, Mawson Lakes SA 5095</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-brand-navy text-white py-20 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots-soft"></div>
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-6">
          Ready to talk?
        </p>
        <p class="text-3xl md:text-5xl font-bold leading-tight mb-10">
          Tell us about your home —<br class="hidden md:inline" />
          <span class="text-brand-amber">we'll tell you how we can help.</span>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="bg-brand-amber text-brand-navy font-semibold px-8 py-4 rounded-md hover:bg-brand-amber-soft transition">
            Contact us
          </a>
          <a href="tel:0410323034" class="border-2 border-white text-white font-semibold px-8 py-4 rounded-md hover:bg-white/10 transition">
            Call 0410 323 034
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PhoneCTA />
</Layout>
