---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneCTA from '../components/PhoneCTA.astro';

const principles = [
  {
    title: 'Clear advice. Long-term systems.',
    body: "We focus on clear advice, reliable workmanship and systems that make sense long term. Our role is to help builders, designers and homeowners make better electrical and smart-home decisions before the work becomes expensive to change.",
  },
  {
    title: 'Specified. Not improvised.',
    body: 'Every scope — from capacity planning to a full luxury programme — starts with a documented spec. No "we\'ll figure it out on site" surprises.',
  },
  {
    title: 'On time, every time.',
    body: 'Locked timeframes where the programme demands it. Clear communication. If we cause a delay, the cost is on us — in writing.',
  },
  {
    title: 'Same crew, every visit.',
    body: "We don't subcontract. The electrician you meet at briefing is the one on site at handover.",
  },
];
---

<Layout
  title="About — Better Home Technology | Premium Residential Electrical & Smart Infrastructure"
  description="We bring electrical, lighting and smart-home infrastructure together early for premium residential design and build — coordinated with builders, designers and homeowners."
>
  <Header />

  <main>
    <section class="bg-brand-navy text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-brand-hero-gradient pointer-events-none"></div>
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots"></div>
      <div class="relative mx-auto max-w-4xl px-6 py-20 md:py-28">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.25em] uppercase mb-6">
          About Better Home Technology
        </p>
        <h1 class="text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight">
          Electrical, lighting and smart infrastructure<br class="hidden md:inline" />
          <span class="text-brand-amber">for homes that are designed — not patched together.</span>
        </h1>
        <p class="mt-8 text-xl md:text-2xl text-slate-300 max-w-2xl leading-relaxed">
          Licensed electrical contractor (PGE275430). We focus on premium residential programmes, structured
          smart-home integration, and independent inspection where buyers need a clear written verdict.
        </p>
      </div>
    </section>

    <section class="bg-white py-20 md:py-28">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          How we work
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-10">
          Our role on the project
        </h2>
        <div class="space-y-8 text-lg text-brand-ink leading-relaxed">
          <p>
            Our role is to bring <strong class="text-brand-navy">electrical, lighting and smart-home infrastructure</strong> together
            early in the residential design and build process — so circuits, containment, scenes, and headroom for
            climate and EV are resolved while drawings are still flexible, not after joinery and plaster lock you in.
          </p>
          <p>
            We work with <strong class="text-brand-navy">builders, designers and homeowners</strong> to make homes safer, cleaner,
            smarter and easier to live in — with documentation and handover that match the calibre of the build.
          </p>
          <p>
            We are <strong class="text-brand-navy">not trying to be the cheapest trade on site.</strong> We focus on reliable
            coordination, clean execution and systems that make sense long after the certificate is issued.
          </p>
        </div>
        <p class="mt-10 text-base text-brand-muted leading-relaxed">
          Office: Level 3, 1-3 Metro Parade, Mawson Lakes SA 5095. Documentation and outcomes aligned to the project record and handover standard.
        </p>
      </div>
    </section>

    <section class="bg-brand-surface-alt py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          What we stand for
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-12">
          Principles you can hold us to.
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {principles.map((p) => (
            <div class="bg-white rounded-xl p-8 border-l-4 border-brand-amber">
              <h3 class="text-xl font-bold text-brand-ink mb-3">{p.title}</h3>
              <p class="text-base text-brand-muted leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-20 md:py-24">
      <div class="mx-auto max-w-4xl px-6">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-3">
          Credentials
        </p>
        <h2 class="text-4xl md:text-5xl font-bold text-brand-ink tracking-tight mb-10">
          Licensed, insured, on the books.
        </h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-base">
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Company</dt>
            <dd class="font-bold text-brand-ink">Better Home Technology Pty Ltd</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">ABN</dt>
            <dd class="font-bold text-brand-ink">56 613 514 640</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Electrical Contractor Licence</dt>
            <dd class="font-bold text-brand-ink">PGE275430</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Coverage</dt>
            <dd class="font-bold text-brand-ink">Public Liability + Workers Compensation</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Workmanship Warranty</dt>
            <dd class="font-bold text-brand-ink">3 years on every install</dd>
          </div>
          <div class="border-t-2 border-brand-amber pt-4">
            <dt class="text-sm uppercase tracking-wider font-semibold text-brand-muted mb-1">Office</dt>
            <dd class="font-bold text-brand-ink">Level 3, 1-3 Metro Parade, Mawson Lakes SA 5095</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="bg-brand-navy text-white py-20 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none opacity-100 bg-brand-pattern-dots-soft"></div>
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <p class="text-brand-amber text-sm font-semibold tracking-[0.2em] uppercase mb-6">
          Next step
        </p>
        <p class="text-3xl md:text-5xl font-bold leading-tight mb-10">
          Tell us about your programme or property —<br class="hidden md:inline" />
          <span class="text-brand-amber">we'll respond with a clear path.</span>
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/for-builders" class="bg-brand-amber text-brand-navy font-semibold px-8 py-4 rounded-md hover:bg-brand-amber-soft transition">
            Builder &amp; design enquiries
          </a>
          <a href="/contact" class="border-2 border-white text-white font-semibold px-8 py-4 rounded-md hover:bg-white/10 transition">
            Contact us
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <PhoneCTA />
</Layout>
