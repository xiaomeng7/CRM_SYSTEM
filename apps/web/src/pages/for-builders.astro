---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const commitments = [
  ['Programme', 'A clear sequence agreed before work begins, with progress and risks communicated while they can still be managed.'],
  ['Coordination', 'Direct communication with the site manager and adjacent trades so framing, HVAC, plumbing, joinery and plaster stay aligned.'],
  ['Commercial clarity', 'A documented scope and one variation process: evidence, options, cost impact and written approval before chargeable work proceeds.'],
  ['Handover', 'Testing, compliance documentation, as-built records and a client walkthrough that does not leave support questions with the builder.'],
];

const stages = [
  ['01', 'Early conversation', 'Review the plans, design intent, programme and future requirements before the electrical scope becomes fixed.'],
  ['02', 'Design and specification', 'Resolve lighting, circuits, capacity, controls and interfaces as one coordinated package.'],
  ['03', '1st Fix', 'Install infrastructure in sequence with framing, plumbing, HVAC and joinery — with issues raised early.'],
  ['04', '2nd Fix and commissioning', 'Complete visible fittings carefully, energise, test and prepare the home for the way the client will use it.'],
  ['05', 'Handover and support', 'Provide compliance records, system information and a clear path for ongoing client support.'],
];

const selectedWork = [
  {
    image: 'work-builder-wiring',
    label: '1st Fix',
    title: 'Infrastructure coordinated before it disappears.',
    body: 'Cabling, containment and access are resolved while the structure is still open and change remains practical.',
  },
  {
    image: 'work-team-brass-chandelier',
    label: 'Final fit',
    title: 'Protecting the detail the designer intended.',
    body: 'Large decorative fittings demand planning, support and careful sequencing — not an improvised decision at handover.',
  },
  {
    image: 'work-control-panels',
    label: 'Systems',
    title: 'Complexity organised behind the finished home.',
    body: 'Control and distribution are documented so the visible spaces can remain calm and the system remains serviceable.',
  },
];

const assurances = [
  ['One project lead', 'A consistent point of contact from early coordination through handover.'],
  ['Our own delivery team', 'The people briefed on the intent remain close to the work.'],
  ['Three-year workmanship warranty', 'Our installation work is supported after handover.'],
  ['Licensed and insured', 'Electrical Contractor Licence PGE275430 with appropriate business coverage.'],
];
---

<Layout
  title="For Builders & Designers | Better Home Technology"
  description="A considered electrical, lighting and residential technology partner for Adelaide builders and designers."
>
  <Header />

  <main class="bg-[#f5f1ea] text-[#252823]">
    <section class="relative min-h-[calc(100svh-5.5rem)] overflow-hidden bg-[#202620] text-[#f5f1e9]">
      <picture class="absolute inset-0 block">
        <source srcset="/images/work-builder-wiring.webp" type="image/webp" />
        <img
          src="/images/work-builder-wiring.jpg"
          alt=""
          width="800"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover object-center opacity-[0.5]"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-r from-[#1e251e]/96 via-[#1e251e]/78 to-[#1e251e]/28"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#1e251e]/55 via-transparent to-[#1e251e]/18"></div>

      <div class="relative mx-auto flex min-h-[calc(100svh-5.5rem)] max-w-[1160px] items-center px-6 py-24 md:px-10">
        <div class="max-w-[52rem]">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d5c17b]">For builders and designers</p>
          <h1 class="mt-7 text-[clamp(3.5rem,7.2vw,7rem)] font-normal leading-[0.9] tracking-[-0.04em]" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Protect the design. Respect the programme.
          </h1>
          <p class="mt-8 max-w-[39rem] text-base leading-[1.8] text-white/72 md:text-lg">
            Electrical, lighting and residential technology considered early, coordinated carefully and carried through to a clear handover.
          </p>
          <a href="#project-conversation" class="mt-10 inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#d2b86f] px-9 text-sm font-semibold text-[#1f261f] transition-colors hover:bg-[#dfc985]">
            Discuss a project
          </a>
        </div>
      </div>
    </section>

    <section class="bg-[#e8e5de] py-24 md:py-36">
      <div class="mx-auto grid max-w-[1080px] gap-12 px-6 md:grid-cols-[0.7fr_1.3fr] md:px-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Our role in the build</p>
          <p class="mt-5 max-w-xs text-sm leading-[1.75] text-[#7a8077]">One coordinated electrical and residential technology partner from design through handover.</p>
        </div>
        <div>
          <h2 class="text-5xl font-normal leading-[1.01] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Resolve the invisible work while the drawings are still flexible.
          </h2>
          <p class="mt-8 max-w-[44rem] text-base leading-[1.85] text-[#666c63]">
            Good residential delivery depends on decisions that are rarely visible in the finished photography: capacity, routes, mounting, interfaces, access and sequence. We bring those questions forward, before joinery and plaster make them expensive.
          </p>
          <p class="mt-6 max-w-[44rem] text-base leading-[1.85] text-[#666c63]">
            That protects the architecture, gives the builder clearer control of programme and leaves the client with a home that feels resolved rather than assembled trade by trade.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#596458] py-24 text-white md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d8c57e]">What the partnership should feel like</p>
        <h2 class="mt-6 max-w-[50rem] text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          Fewer surprises. Clearer responsibility.
        </h2>

        <div class="mt-16 grid border-t border-white/15 md:grid-cols-2">
          {commitments.map(([title, body], index) => (
            <article class:list={[
              'border-b border-white/15 py-9 md:min-h-[17rem] md:p-10',
              index % 2 === 0 ? 'md:border-r' : '',
            ]}>
              <h3 class="text-3xl font-normal md:text-4xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">{title}</h3>
              <p class="mt-5 max-w-md text-[15px] leading-[1.8] text-white/62">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#f5f1ea] py-24 md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Across the project</p>
        <h2 class="mt-6 max-w-[48rem] text-5xl font-normal leading-[1.01] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          One idea, carried through five stages.
        </h2>

        <div class="mt-16 border-t border-[#c9c2b6]">
          {stages.map(([number, title, body]) => (
            <article class="grid gap-5 border-b border-[#c9c2b6] py-8 md:grid-cols-[0.18fr_0.52fr_1.3fr] md:items-start md:gap-8">
              <p class="text-[10px] font-semibold tracking-[0.2em] text-[#788471]">{number}</p>
              <h3 class="text-2xl font-normal text-[#333932] md:text-3xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">{title}</h3>
              <p class="max-w-2xl text-[15px] leading-[1.75] text-[#6c7169]">{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#d7ddd1] py-24 md:py-32">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#596754]">Selected delivery details</p>
        <h2 class="mt-6 max-w-[48rem] text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
          The finished result begins much earlier.
        </h2>

        <div class="mt-16 grid gap-12 md:grid-cols-3 md:gap-7">
          {selectedWork.map((work) => (
            <article>
              <picture class="block overflow-hidden rounded-[1.5rem] bg-[#bcc5b6]">
                <source srcset={`/images/${work.image}.webp`} type="image/webp" />
                <img
                  src={`/images/${work.image}.jpg`}
                  alt={work.title}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/3] h-full w-full object-cover"
                />
              </picture>
              <p class="mt-7 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#65725f]">{work.label}</p>
              <h3 class="mt-4 text-3xl font-normal leading-[1.08]" style="font-family: 'Cormorant Garamond', Georgia, serif;">{work.title}</h3>
              <p class="mt-4 text-[15px] leading-[1.75] text-[#697067]">{work.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#e8e5de] py-24 md:py-28">
      <div class="mx-auto grid max-w-[1080px] gap-12 px-6 md:grid-cols-[0.72fr_1.28fr] md:px-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#65755d]">Professional assurance</p>
          <h2 class="mt-6 text-4xl font-normal leading-[1.05] md:text-6xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Confidence without noise.
          </h2>
        </div>
        <dl class="grid gap-x-10 sm:grid-cols-2">
          {assurances.map(([title, body]) => (
            <div class="border-t border-[#c2bbaf] py-7">
              <dt class="text-base font-semibold text-[#465241]">{title}</dt>
              <dd class="mt-3 text-[15px] leading-[1.75] text-[#6c7169]">{body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="project-conversation" class="bg-[#293129] py-24 text-[#f3eee5] md:py-32">
      <div class="mx-auto grid max-w-[1080px] gap-12 px-6 md:grid-cols-[1.1fr_0.9fr] md:items-end md:px-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#d0bd7b]">A useful first conversation</p>
          <h2 class="mt-7 text-5xl font-normal leading-[0.98] md:text-7xl" style="font-family: 'Cormorant Garamond', Georgia, serif;">
            Send the plans before the scope hardens.
          </h2>
          <p class="mt-7 max-w-xl text-base leading-[1.8] text-white/62">
            We will review the project intent, programme and likely coordination points, then tell you clearly whether we are the right delivery partner.
          </p>
        </div>
        <div class="flex flex-col gap-4 md:items-start">
          <a href="mailto:Info@bhtechnology.com.au?subject=Builder%20Project%20Conversation" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#d2b86f] px-9 text-sm font-semibold text-[#1f261f] transition-colors hover:bg-[#dfc985]">
            Send us your plans
          </a>
          <a href="tel:0410323034" class="inline-flex min-h-[48px] items-center text-sm font-semibold text-white/75 transition-colors hover:text-white">
            Or call 0410 323 034
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer minimal />
</Layout>
