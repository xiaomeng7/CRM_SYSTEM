---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import importPlan from '../../../../packages/product-os/generated/import-plan-v2.07.json';
import { betterHomeProducts } from '../lib/better-home-products';

const shopProducts = betterHomeProducts.map((product) => ({
  code: product.productCode,
  name: product.canonicalName,
  kind: product.productKind,
  price: product.price.amount,
  priceLabel: product.price.amountLabel,
  fulfilment: product.price.fulfilmentLabel,
  image: product.image,
  hero: product.hero,
  subtitle: product.subtitle,
  experiencePreview: product.experiences.slice(0, 4).map((experience) => ({
    title: experience.title,
    description: experience.description,
  })),
  included: (() => {
    if (product.productCode === 'F-01') {
      return [
        'One central 10-inch home screen',
        'Home network and device gateways',
        'Shared system programming',
        'Setup, testing and customer handover',
      ];
    }
    const approvedScope = importPlan.a4ScopePresentation
      .filter((group) => group.productCode === product.productCode)
      .flatMap((group) => group.lines);
    if (approvedScope.length) return approvedScope.slice(0, 8);
    return product.capabilities.slice(0, 6).map((capability) =>
      `${capability.includedQty} × ${capability.capabilityName}`
    );
  })(),
}));

const shopAddons = importPlan.addons
  .filter((addon) => addon.eligibilityStatus === 'ELIGIBLE')
  .map((addon) => ({
    code: addon.productCode,
    name: addon.canonicalName,
    price: addon.customerPriceInclGst,
    promise: addon.experiencePromise,
    parents: addon.parentProductCodes,
  }));
---

<Layout title="Build your Better Home" description="Choose the spaces and experiences that matter, see a clear estimate, and ask Better Home to confirm the final scope.">
  <Header />
  <main class="better-home-shop bg-[#f5f1ea] text-[#252823]">
    <section class="border-b border-[#d9d3c9]">
      <div class="mx-auto max-w-[1160px] px-6 py-16 md:px-10 md:py-24">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">Build your Better Home</p>
        <div class="mt-5 grid gap-8 md:grid-cols-[1.15fr_0.85fr] md:items-end">
          <h1 class="text-[clamp(3.6rem,7vw,6.8rem)] leading-[0.9] tracking-[-0.045em]">One home.<br />Built around you.</h1>
          <p class="max-w-xl text-lg leading-relaxed text-[#686d65]">Choose a Foundation, the rooms that shape your day, and the experiences you value. Your estimate updates as you build.</p>
        </div>
      </div>
    </section>

    <nav class="sticky top-[5.5rem] z-30 border-b border-[#d9d3c9] bg-[#f5f1ea]/95 backdrop-blur-md" aria-label="Build steps">
      <div class="mx-auto flex max-w-[1160px] gap-6 overflow-x-auto px-6 py-4 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#70776d] md:px-10">
        <a href="#foundation" class="whitespace-nowrap hover:text-[#30372f]">01 Foundation</a>
        <a href="#collections" class="whitespace-nowrap hover:text-[#30372f]">02 Rooms</a>
        <a href="#experiences" class="whitespace-nowrap hover:text-[#30372f]">03 Experiences</a>
        <a href="#addons" class="whitespace-nowrap hover:text-[#30372f]">04 Add-ons</a>
        <a href="#details" class="whitespace-nowrap hover:text-[#30372f]">05 Review</a>
      </div>
    </nav>

    <section class="border-b border-[#d9d3c9] bg-[#faf8f4]">
      <div class="mx-auto max-w-[1160px] px-6 py-12 md:px-10 md:py-16">
        <div class="grid gap-8 md:grid-cols-[0.7fr_1.3fr]">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">How to choose</p>
            <h2 class="mt-4 font-['Cormorant_Garamond',Georgia,serif] text-4xl font-normal leading-tight">Build it like a home, not a list of devices.</h2>
          </div>
          <div class="grid gap-px overflow-hidden rounded-2xl border border-[#d8d1c5] bg-[#d8d1c5] sm:grid-cols-2">
            <article class="bg-[#f5f1ea] p-5"><strong class="text-sm">Foundation · once</strong><p class="mt-2 text-sm leading-relaxed text-[#686d65]">The shared core for the connected home. It is automatically added when your selection needs it.</p></article>
            <article class="bg-[#f5f1ea] p-5"><strong class="text-sm">Collections · per room</strong><p class="mt-2 text-sm leading-relaxed text-[#686d65]">Choose one for each Entry, Living, Kitchen, Bedroom, Bathroom or Away routine you want.</p></article>
            <article class="bg-[#f5f1ea] p-5"><strong class="text-sm">Experiences · where useful</strong><p class="mt-2 text-sm leading-relaxed text-[#686d65]">Add atmosphere, air, climate, garden care or monitoring to the part of life it supports.</p></article>
            <article class="bg-[#f5f1ea] p-5"><strong class="text-sm">Add-ons · more coverage</strong><p class="mt-2 text-sm leading-relaxed text-[#686d65]">Extend something already selected—another curtain, lighting zone, sensor or compatible device.</p></article>
          </div>
        </div>
      </div>
    </section>

    <form id="better-home-builder" class="mx-auto grid max-w-[1320px] gap-10 px-6 py-14 md:px-10 lg:grid-cols-[1fr_22rem] lg:items-start">
      <div class="space-y-16">
        <section id="foundation" class="scroll-mt-40" data-step="foundation">
          <p class="shop-step">01 · Foundation</p>
          <h2 class="shop-title">Begin with the home.</h2>
          <p class="shop-intro">Foundation is selected once and quietly connects the Collections and connected Experiences you add.</p>
          <div class="mt-8" data-product-grid="FOUNDATION"></div>
        </section>

        <section id="collections" class="scroll-mt-40" data-step="collections">
          <p class="shop-step">02 · Collections</p>
          <h2 class="shop-title">Choose your rooms.</h2>
          <p class="shop-intro">Add more than one of the same Collection when your home has several bedrooms, bathrooms or living spaces.</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3" data-product-grid="COLLECTION"></div>
        </section>

        <section id="experiences" class="scroll-mt-40" data-step="experiences">
          <p class="shop-step">03 · Experiences</p>
          <h2 class="shop-title">Add what matters.</h2>
          <p class="shop-intro">Mood Lighting and Healthy Air belong to a selected room. Climate supports central air conditioning without choosing a room. Garden Care, CCTV and Smart Toilet may begin independently.</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3" data-product-grid="EXPERIENCES"></div>
        </section>

        <section id="addons" class="scroll-mt-40" data-step="addons">
          <p class="shop-step">04 · Add-ons</p>
          <h2 class="shop-title">Extend what already belongs.</h2>
          <p class="shop-intro">Only Add-ons permitted by your current selections will appear here. An Add-on does not create a new room or Experience.</p>
          <div id="addon-grid" class="mt-8 grid gap-4 sm:grid-cols-2"></div>
        </section>

        <section id="details" class="scroll-mt-40 border-t border-[#cfc9bf] pt-14" data-step="details">
          <p class="shop-step">05 · Your details</p>
          <h2 class="shop-title">Ask us to confirm your plan.</h2>
          <p class="shop-intro">This sends your selection to Better Home for review. It is not a contract, and no payment is taken.</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <label class="shop-field"><span>Name</span><input name="name" autocomplete="name" required /></label>
            <label class="shop-field"><span>Phone</span><input name="phone" autocomplete="tel" required /></label>
            <label class="shop-field"><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
            <label class="shop-field"><span>Suburb</span><input name="suburb" autocomplete="address-level2" required /></label>
            <label class="shop-field sm:col-span-2"><span>What should we know?</span><textarea name="notes" rows="4"></textarea></label>
          </div>
          <button type="submit" class="mt-7 inline-flex min-h-[52px] items-center rounded-full bg-[#65755d] px-8 text-sm font-semibold text-white transition hover:bg-[#53614d]">Send my selection</button>
          <p id="shop-status" class="mt-5 text-sm text-[#65755d]" role="status" aria-live="polite"></p>
        </section>
      </div>

      <aside class="order-first top-36 rounded-3xl bg-[#30372f] p-7 text-white shadow-[0_2rem_5rem_rgba(46,50,45,0.14)] lg:order-none lg:sticky">
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#c6d0bd]">Your Better Home</p>
        <div id="selection-summary" class="mt-6 space-y-3 text-sm text-[#e2e7de]"><p>Nothing selected yet.</p></div>
        <div class="mt-7 border-t border-white/15 pt-6">
          <div class="flex items-end justify-between gap-4">
            <p class="text-xs uppercase tracking-[0.14em] text-[#c6d0bd]">Estimated total</p>
            <p id="estimated-total" class="text-4xl">$0</p>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-[#b9c2b3]">A guide based on standard scope. Final price follows site review and confirmed selections.</p>
        </div>
      </aside>
    </form>
  </main>
  <Footer />
</Layout>

<script is:inline define:vars={{ shopProducts, shopAddons }}>
  const productByCode = Object.fromEntries(shopProducts.map((product) => [product.code, product]));
  const selection = new Map();
  const addonSelection = new Map();
  const experienceTargets = new Map();
  const linkedToFoundation = new Set(['C-01','C-02','C-03','C-04','C-05','C-06','E-01','E-02','E-03']);
  const roomExperiences = new Set(['E-01','E-03']);
  const compatibleByExperience = {
    'E-01': ['C-02','C-03','C-04','C-05'],
    'E-03': ['C-02','C-03','C-04'],
  };
  const formatter = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 });

  function quantity(code) { return selection.get(code) || 0; }
  function updateFoundation() {
    const needsFoundation = [...selection].some(([code, qty]) => qty > 0 && linkedToFoundation.has(code));
    if (needsFoundation) selection.set('F-01', 1);
  }
  function compatibleRooms(code) {
    return (compatibleByExperience[code] || []).flatMap((roomCode) =>
      Array.from({ length: quantity(roomCode) }, (_, index) => ({
        key: `${roomCode}:${index + 1}`,
        label: `${productByCode[roomCode].name.replace(' Collection', '')} ${index + 1}`,
      }))
    );
  }
  function reconcileTargets() {
    for (const code of roomExperiences) {
      const rooms = compatibleRooms(code);
      const validKeys = new Set(rooms.map((room) => room.key));
      const current = (experienceTargets.get(code) || []).filter((key) => validKeys.has(key));
      const wanted = Math.min(quantity(code), rooms.length);
      for (const room of rooms) {
        if (current.length >= wanted) break;
        if (!current.includes(room.key)) current.push(room.key);
      }
      if (current.length) {
        experienceTargets.set(code, current);
        selection.set(code, current.length);
      } else {
        experienceTargets.delete(code);
        selection.delete(code);
      }
    }
  }
  function setQuantity(code, next) {
    if (code === 'F-01' && next === 0 && [...selection].some(([item, qty]) => qty > 0 && linkedToFoundation.has(item))) return;
    next > 0 ? selection.set(code, next) : selection.delete(code);
    updateFoundation();
    reconcileTargets();
    render();
  }
  function productCard(product) {
    const qty = quantity(product.code);
    const isRoomExperience = roomExperiences.has(product.code);
    const availableRooms = roomExperiences.has(product.code) ? compatibleRooms(product.code) : [];
    const hasRoom = availableRooms.length > 0;
    const disabled = isRoomExperience && !hasRoom;
    const targets = experienceTargets.get(product.code) || [];
    const targetControls = targets.map((target, index) => `<label class="mt-3 block text-xs text-[#65755d]">
      <span class="mb-1 block uppercase tracking-[.11em]">Room ${index + 1}</span>
      <select data-experience-target="${product.code}" data-target-index="${index}" class="w-full rounded-lg border border-[#d0cabf] bg-[#f7f4ee] px-3 py-2 text-sm text-[#30352f]">
        ${availableRooms.map((room) => `<option value="${room.key}" ${room.key === target ? 'selected' : ''}>${room.label}</option>`).join('')}
      </select>
    </label>`).join('');
    const experiences = product.experiencePreview.length
      ? `<div><p class="shop-detail-label">What it brings</p>${product.experiencePreview.map((item) => `<div class="mt-3"><strong class="block text-sm">${item.title}</strong><p class="mt-1 text-xs leading-relaxed text-[#686d65]">${item.description}</p></div>`).join('')}</div>`
      : '';
    const included = product.included.length
      ? `<div class="mt-5 border-t border-[#ddd7cc] pt-4"><p class="shop-detail-label">Standard scope</p><ul class="mt-3 space-y-1.5 text-xs leading-relaxed text-[#5f665d]">${product.included.map((item) => `<li>— ${item}</li>`).join('')}</ul></div>`
      : '';
    return `<article class="shop-card ${qty ? 'is-selected' : ''}">
      <img src="${product.image}" alt="" loading="lazy" />
      <div class="p-5">
        <p class="text-[10px] font-semibold uppercase tracking-[.15em] text-[#7a8474]">${product.code}</p>
        <h3>${product.name}</h3>
        <p class="mt-2 min-h-[3.5rem] text-sm leading-relaxed text-[#686d65]">${product.subtitle || product.hero}</p>
        <div class="mt-4 flex items-baseline justify-between gap-3"><span>${product.priceLabel}</span><small>${product.fulfilment}</small></div>
        ${disabled ? '<p class="mt-3 text-xs leading-relaxed text-[#8b6f57]">Choose a compatible room first.</p>' : ''}
        ${targetControls}
        <details class="shop-details mt-4 border-y border-[#e0d9cf] py-3">
          <summary class="cursor-pointer list-none text-xs font-semibold uppercase tracking-[.12em] text-[#65755d]"><span>What is this?</span><span aria-hidden="true">＋</span></summary>
          <div class="pt-4">${experiences}${included}</div>
        </details>
        <div class="mt-5 flex items-center justify-between">
          <button type="button" data-minus="${product.code}" aria-label="Remove one ${product.name}" ${qty < 1 ? 'disabled' : ''}>−</button>
          <strong>${qty}</strong>
          <button type="button" data-plus="${product.code}" aria-label="Add one ${product.name}" ${disabled || product.code === 'F-01' && qty || isRoomExperience && qty >= availableRooms.length ? 'disabled' : ''}>+</button>
        </div>
      </div>
    </article>`;
  }
  function renderProducts() {
    const foundation = document.querySelector('[data-product-grid="FOUNDATION"]');
    const collections = document.querySelector('[data-product-grid="COLLECTION"]');
    const experiences = document.querySelector('[data-product-grid="EXPERIENCES"]');
    foundation.innerHTML = shopProducts.filter((p) => p.kind === 'FOUNDATION').map(productCard).join('');
    collections.innerHTML = shopProducts.filter((p) => p.kind === 'COLLECTION').map(productCard).join('');
    experiences.innerHTML = shopProducts.filter((p) => p.kind === 'EXPERIENCE' || p.kind === 'STANDALONE').map(productCard).join('');
    document.querySelectorAll('[data-plus]').forEach((button) => button.addEventListener('click', () => setQuantity(button.dataset.plus, quantity(button.dataset.plus) + 1)));
    document.querySelectorAll('[data-minus]').forEach((button) => button.addEventListener('click', () => setQuantity(button.dataset.minus, Math.max(0, quantity(button.dataset.minus) - 1))));
    document.querySelectorAll('[data-experience-target]').forEach((select) => select.addEventListener('change', () => {
      const code = select.dataset.experienceTarget;
      const index = Number(select.dataset.targetIndex);
      const targets = [...(experienceTargets.get(code) || [])];
      const duplicateIndex = targets.indexOf(select.value);
      if (duplicateIndex >= 0 && duplicateIndex !== index) {
        const previous = targets[index];
        targets[duplicateIndex] = previous;
      }
      targets[index] = select.value;
      experienceTargets.set(code, targets);
      render();
    }));
  }
  function eligibleAddons() {
    return shopAddons.filter((addon) => addon.parents.some((parent) => quantity(parent) > 0));
  }
  function renderAddons() {
    const eligible = eligibleAddons();
    for (const code of [...addonSelection.keys()]) if (!eligible.some((addon) => addon.code === code)) addonSelection.delete(code);
    document.getElementById('addon-grid').innerHTML = eligible.length ? eligible.map((addon) => {
      const qty = addonSelection.get(addon.code) || 0;
      return `<article class="rounded-2xl border ${qty ? 'border-[#65755d] bg-white' : 'border-[#d8d1c5] bg-[#faf8f4]'} p-5">
        <p class="text-[10px] font-semibold uppercase tracking-[.14em] text-[#7a8474]">${addon.code}</p>
        <h3 class="mt-3 text-2xl">${addon.name}</h3><p class="mt-2 text-sm leading-relaxed text-[#686d65]">${addon.promise}</p>
        <div class="mt-4 flex items-center justify-between"><span>${formatter.format(addon.price)}</span><div class="flex items-center gap-4"><button type="button" data-addon-minus="${addon.code}" ${qty < 1 ? 'disabled' : ''}>−</button><strong>${qty}</strong><button type="button" data-addon-plus="${addon.code}">+</button></div></div>
      </article>`;
    }).join('') : '<p class="text-sm text-[#686d65]">Choose a Collection or Experience to see its permitted Add-ons.</p>';
    document.querySelectorAll('[data-addon-plus]').forEach((button) => button.addEventListener('click', () => { addonSelection.set(button.dataset.addonPlus, (addonSelection.get(button.dataset.addonPlus) || 0) + 1); render(); }));
    document.querySelectorAll('[data-addon-minus]').forEach((button) => button.addEventListener('click', () => { const next=(addonSelection.get(button.dataset.addonMinus)||0)-1; next>0?addonSelection.set(button.dataset.addonMinus,next):addonSelection.delete(button.dataset.addonMinus); render(); }));
  }
  function renderSummary() {
    const items = [...selection].filter(([,qty]) => qty > 0).map(([code, qty]) => ({ name: productByCode[code].name, qty, total: productByCode[code].price * qty }));
    const addonItems = [...addonSelection].map(([code, qty]) => { const item=shopAddons.find((a)=>a.code===code); return {name:item.name,qty,total:item.price*qty}; });
    const all = [...items, ...addonItems];
    document.getElementById('selection-summary').innerHTML = all.length ? all.map((item) => `<div class="flex justify-between gap-4"><span>${item.qty} × ${item.name}</span><span>${formatter.format(item.total)}</span></div>`).join('') : '<p>Nothing selected yet.</p>';
    document.getElementById('estimated-total').textContent = formatter.format(all.reduce((sum,item)=>sum+item.total,0));
  }
  function render() { renderProducts(); renderAddons(); renderSummary(); }

  const requested = new URLSearchParams(location.search).get('add');
  if (productByCode[requested]) selection.set(requested, 1);
  updateFoundation();
  render();

  document.getElementById('better-home-builder').addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = document.getElementById('shop-status');
    if (![...selection.values()].some((qty) => qty > 0)) { status.textContent = 'Choose at least one product first.'; return; }
    const form = new FormData(event.currentTarget);
    const campaign = new URLSearchParams(location.search);
    status.textContent = 'Sending your selection…';
    const payload = {
      name: form.get('name'), phone: form.get('phone'), email: form.get('email'), suburb: form.get('suburb'), notes: form.get('notes'),
      selections: [...selection].map(([code, quantity]) => ({ code, quantity, name: productByCode[code].name, unitPrice: productByCode[code].price })),
      experienceTargets: [...experienceTargets].flatMap(([code, targets]) => targets.map((target) => ({ experienceCode: code, room: target }))),
      addons: [...addonSelection].map(([code, quantity]) => { const addon=shopAddons.find((item)=>item.code===code); return { code, quantity, name:addon.name, unitPrice:addon.price }; }),
      estimatedTotal: [...selection].reduce((sum,[code,qty])=>sum+productByCode[code].price*qty,0)+[...addonSelection].reduce((sum,[code,qty])=>sum+shopAddons.find((a)=>a.code===code).price*qty,0),
      page_url: location.href,
      attribution: {
        utm_source: campaign.get('utm_source'),
        utm_medium: campaign.get('utm_medium'),
        utm_campaign: campaign.get('utm_campaign'),
        utm_content: campaign.get('utm_content'),
        gclid: campaign.get('gclid'),
      },
    };
    try {
      const response = await fetch('/.netlify/functions/submit-better-home-selection', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Please try again.');
      sessionStorage.setItem('betterHomeSubmission', JSON.stringify({ name: payload.name, estimatedTotal: payload.estimatedTotal }));
      location.href = `/shop/thank-you${result.reference ? `?ref=${encodeURIComponent(result.reference)}` : ''}`;
    } catch (error) { status.textContent = error.message || 'We could not send this selection. Please call 0410 323 034.'; }
  });
</script>

<style is:global>
  .better-home-shop h1,.better-home-shop h2,.better-home-shop h3,.better-home-shop #estimated-total{font-family:'Cormorant Garamond',Georgia,serif!important;font-weight:400}
  .shop-step{font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#65755d}
  .shop-title{margin-top:1.25rem;font-size:clamp(2.5rem,5vw,4rem);line-height:1}
  .shop-intro{margin-top:1.25rem;max-width:46rem;font-size:1rem;line-height:1.75;color:#686d65}
  .shop-card{overflow:hidden;border:1px solid #d8d1c5;border-radius:1.25rem;background:#faf8f4;transition:.25s}
  .shop-card.is-selected{border-color:#65755d;background:white;box-shadow:0 1rem 3rem rgba(57,55,49,.08)}
  .shop-card img{width:100%;aspect-ratio:16/8;object-fit:cover}
  .shop-card h3{margin-top:.6rem;font-size:1.75rem}
  .shop-card small{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#899183}
  .shop-card button,[data-addon-plus],[data-addon-minus]{display:inline-flex;width:2rem;height:2rem;align-items:center;justify-content:center;border:1px solid #c9c3b8;border-radius:999px}
  .shop-card button:disabled,[data-addon-plus]:disabled,[data-addon-minus]:disabled{opacity:.3}
  .shop-details summary{display:flex;align-items:center;justify-content:space-between}
  .shop-details[open] summary span:last-child{transform:rotate(45deg)}
  .shop-detail-label{font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#7a8474}
  .shop-field{display:flex;flex-direction:column;gap:.55rem;font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:#65755d}
  .shop-field input,.shop-field textarea{border:1px solid #cfc9bf;border-radius:.75rem;background:#faf8f4;padding:.9rem 1rem;font-size:1rem;font-weight:400;letter-spacing:0;text-transform:none;color:#252823;outline:none}
  .shop-field input:focus,.shop-field textarea:focus{border-color:#65755d;box-shadow:0 0 0 3px rgba(101,117,93,.12)}
</style>
