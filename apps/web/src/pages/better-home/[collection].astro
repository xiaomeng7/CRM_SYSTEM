---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCustomerPrice } from '../../lib/product-pricing';
import { createRequire } from 'node:module';

export function getStaticPaths() {
  const require = createRequire(import.meta.url);
  const { APPROVED_COLLECTION_A4 } = require('../../../../../packages/product-os/src/v2/import/approved-a4-content.js');
  const collectionRoutes = [
    { id: 'C-01', slug: 'entry' },
    { id: 'C-02', slug: 'living' },
    { id: 'C-03', slug: 'kitchen' },
    { id: 'C-04', slug: 'bedroom' },
    { id: 'C-05', slug: 'bathroom' },
    { id: 'C-06', slug: 'away' },
  ];
  return collectionRoutes.map(({ id, slug }) => ({
    params: { collection: slug },
    props: { id, slug, content: APPROVED_COLLECTION_A4[id] },
  }));
}

const { id, slug, content } = Astro.props;
const shortName = content.productName.replace(' Collection', '');
const price = getCustomerPrice(id);
---

<Layout
  title={`${content.productName} | Better Home`}
  description={`${content.hero} ${content.subtitle}`}
>
  <Header />
  <main class="better-home-collection-page bg-[#f5f1ea] text-[#252823]">
    <section class="border-b border-[#d9d3c9]">
      <div class="mx-auto max-w-[1160px] px-6 py-16 md:px-10 md:py-24">
        <a href="/better-home#collections" class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#65755d]">← All Collections</a>
        <div class="mt-14 grid gap-12 md:grid-cols-[0.85fr_1.15fr] md:items-end">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">{id} · Collection</p>
            <h1 class="mt-5 font-['Cormorant_Garamond',Georgia,serif] text-[clamp(3.8rem,8vw,7rem)] font-normal leading-[0.88] tracking-[-0.045em]">{shortName}</h1>
          </div>
          <div class="max-w-2xl">
            <p class="font-['Cormorant_Garamond',Georgia,serif] text-4xl font-normal leading-[1.05] md:text-6xl">{content.hero}</p>
            <p class="mt-6 text-lg leading-relaxed text-[#686d65]">{content.subtitle}</p>
          </div>
        </div>
        <figure class="mt-14 overflow-hidden rounded-[2rem] bg-[#ddd5c8] shadow-[0_2rem_6rem_rgba(57,55,49,0.1)]">
          <picture class="block h-full w-full">
            <source srcset={`/images/better-home/collections/${slug}.webp`} type="image/webp" />
            <img
              src={`/images/better-home/collections/${slug}.jpg`}
              alt={`${content.productName} residential atmosphere`}
              width="804"
              height="821"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/7] h-full w-full object-cover"
            />
          </picture>
        </figure>
      </div>
    </section>

    <section class="bg-[#faf8f4] py-18 md:py-24">
      <div class="mx-auto grid max-w-[1160px] gap-12 px-6 md:grid-cols-[0.8fr_1.2fr] md:px-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">Why it matters</p>
          <h2 class="mt-5 font-['Cormorant_Garamond',Georgia,serif] text-4xl font-normal leading-tight md:text-5xl">{content.storyTitle}</h2>
          <p class="mt-5 text-lg leading-relaxed text-[#686d65]">{content.storyBody}</p>
        </div>
        <div class="grid gap-px overflow-hidden rounded-2xl border border-[#d8d1c5] bg-[#d8d1c5] sm:grid-cols-2">
          {content.moments.map((moment) => (
            <article class="bg-[#f5f1ea] p-7 md:p-8">
              <span class="text-xs text-[#899183]">{String(moment.sequence).padStart(2, '0')}</span>
              <h3 class="mt-5 text-xs font-semibold uppercase tracking-[0.16em] text-[#65755d]">{moment.title}</h3>
              <p class="mt-2 font-['Cormorant_Garamond',Georgia,serif] text-2xl">{moment.caption}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-[#d9d3c9] py-18 md:py-24">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <div class="grid gap-10 md:grid-cols-2">
          <article class="border-t border-[#bdb7ab] pt-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">The problem</p>
            <p class="mt-5 text-xl leading-relaxed">{content.problem}</p>
          </article>
          <article class="border-t border-[#8a987f] pt-6">
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">How Better Home responds</p>
            <p class="mt-5 text-xl leading-relaxed">{content.betterHomeResponse}</p>
          </article>
        </div>

        <div class="mt-16">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">What you experience</p>
          <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {content.experiences.map((experience) => (
              <article class="border-t border-[#cfc9bf] pt-5">
                <span class="text-xs text-[#899183]">{String(experience.sequence).padStart(2, '0')}</span>
                <h3 class="mt-4 text-sm font-semibold uppercase tracking-[0.12em]">{experience.title}</h3>
                <p class="mt-3 leading-relaxed text-[#686d65]">{experience.body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#e9e4da] py-18 md:py-24">
      <div class="mx-auto max-w-[1160px] px-6 md:px-10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">Included in this Collection</p>
        <div class="mt-9 grid gap-px overflow-hidden rounded-2xl border border-[#cec7bb] bg-[#cec7bb] sm:grid-cols-2 lg:grid-cols-3">
          {content.scopeGroups.map((group) => (
            <article class="bg-[#f5f1ea] p-7">
              <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-[#65755d]">{group.heading}</h3>
              <ul class="mt-5 space-y-2 text-[15px] leading-relaxed">
                {group.lines.map((line) => <li>{line}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="mt-10 border-t border-[#bdb7ab] pt-6">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">Installation assumptions</p>
          <p class="mt-4 max-w-4xl text-sm leading-relaxed text-[#686d65]">{content.installationAssumptionsCustomer || content.installationAssumptions}</p>
        </div>
      </div>
    </section>

    <section class="border-t border-[#d9d3c9] bg-[#f5f1ea] py-18 md:py-24">
      <div class="mx-auto grid max-w-[1160px] gap-10 px-6 md:grid-cols-[0.75fr_1.25fr] md:items-end md:px-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#65755d]">Investment</p>
          <p class="editorial-price mt-5 text-5xl font-normal leading-none md:text-7xl">{price.amountLabel}</p>
          <p class="mt-4 text-xs uppercase tracking-[0.14em] text-[#65755d]">{price.fulfilmentLabel} · {price.taxLabel}</p>
        </div>
        <div class="max-w-2xl border-t border-[#cfc9bf] pt-6">
          <p class="text-lg leading-relaxed text-[#4f574d]">A clear starting point for the standard Collection scope shown above.</p>
          <p class="mt-4 text-sm leading-relaxed text-[#686d65]">Site conditions, non-standard construction and additional work may affect the final proposal.</p>
        </div>
      </div>
    </section>

    <section class="bg-[#30372f] py-20 text-white md:py-24">
      <div class="mx-auto grid max-w-[1160px] items-center gap-10 px-6 md:grid-cols-[1fr_auto] md:px-10">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#c6d0bd]">{id} · {content.productName}</p>
          <h2 class="mt-5 max-w-3xl font-['Cormorant_Garamond',Georgia,serif] text-4xl font-normal leading-tight md:text-6xl">Would this make everyday life feel better?</h2>
        </div>
        <div class="flex flex-col gap-3">
          <a href="/contact" class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-[#f5f1ea] px-8 text-sm font-semibold text-[#30372f]">Talk to Better Home</a>
          <a href="/better-home#collections" class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-white/25 px-8 text-sm font-medium text-white">Explore another Collection</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
  .better-home-collection-page h1,
  .better-home-collection-page h2,
  .better-home-collection-page .editorial-price {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-weight: 400;
  }
</style>
