---
/**
 * Short labels + single-line nav — luxury horizontal rhythm (architecture-firm density).
 * Routes unchanged; mobile uses same `navLinks`.
 */
const navLinks = [
  { href: '/better-home', label: 'Products', matches: ['/better-home', '/products'] },
  { href: '/shop', label: 'Shop', matches: ['/shop'] },
  { href: '/projects', label: 'Projects', matches: ['/projects'] },
  { href: '/for-builders', label: 'Professionals', matches: ['/for-builders'] },
  { href: '/about', label: 'About', matches: ['/about'] },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (matches: string[]) =>
  matches.some((path) => currentPath === path || currentPath.startsWith(`${path}/`));
---
<header class="sticky top-0 z-40 border-b border-white/[0.06] bg-[#1f261f] text-white">
  <div
    class="bht-header-inner mx-auto flex max-w-[90rem] flex-nowrap items-center justify-between gap-7 px-6 py-3.5 min-h-[5.5rem] md:min-h-[5.875rem] md:gap-9 md:px-10 md:py-3.5 lg:gap-12 lg:px-12"
  >
    <!-- Header wordmark: icon + BETTER HOME only (no slogan) — better-home-header-logo.png -->
    <a
      href="/"
      class="group flex shrink-0 items-center"
      aria-label="Better Home — Home"
    >
      <img
        src="/better-home-header-logo.png"
        alt="Better Home Technology"
        width="1210"
        height="369"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-auto w-[9.75rem] object-contain object-left select-none opacity-[0.98] transition-opacity duration-300 group-hover:opacity-100 sm:w-[11rem] md:w-[15.5rem] lg:w-[17.5rem]"
      />
    </a>

    <nav
      class="hidden min-w-0 flex-1 flex-nowrap items-center justify-center gap-4 md:flex lg:gap-5 xl:gap-6"
      aria-label="Primary"
    >
      {navLinks.map((link) => {
        const active = isActive(link.matches);
        return (
        <a
          href={link.href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'relative whitespace-nowrap py-3 text-[13px] font-medium leading-none tracking-[0.025em] transition-colors duration-500 ease-out lg:text-[14.5px]',
            active ? 'text-[#f1e7c5]' : 'text-slate-400/95 hover:text-slate-100/95',
          ]}
        >
          {link.label}
          {active && <span class="absolute inset-x-0 -bottom-[1.28rem] h-px bg-[#d2b86f]" aria-hidden="true"></span>}
        </a>
        );
      })}
    </nav>

    <div class="hidden shrink-0 items-center md:flex">
      <a href="/shop" class="bht-header-phone ml-4 inline-flex min-h-10 items-center rounded-full border border-white/20 px-5 text-[12.5px] font-medium tracking-[0.03em] text-slate-100 transition-colors duration-500 hover:border-white/35 hover:bg-white/[0.06] lg:ml-6">Build yours</a>
    </div>

    <div class="flex shrink-0 items-center gap-3 md:hidden">
      <a
        href="tel:0410323034"
        class="text-[13px] font-medium tracking-[0.03em] text-slate-400 transition-colors duration-300 hover:text-slate-200"
      >
        Call
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md border border-white/20 px-3 py-2 text-[14px] font-semibold text-white transition hover:border-white/35 hover:text-white"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
      >
        Menu
      </button>
    </div>
  </div>

  <nav id="mobile-menu-panel" class="hidden border-t border-white/10 bg-[#1f261f] md:hidden">
    <div class="mx-auto max-w-[90rem] px-6 py-3 flex flex-col text-[15px] tracking-[0.04em]">
      <a href="/" data-mobile-nav-link class="py-3 text-slate-200 hover:text-white border-b border-white/5">Home</a>
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-mobile-nav-link
          aria-current={isActive(link.matches) ? 'page' : undefined}
          class:list={[
            'border-b border-white/5 py-3 hover:text-white',
            isActive(link.matches) ? 'text-[#ead79a]' : 'text-slate-200',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href="tel:0410323034" data-mobile-nav-link class="py-3 text-[13px] font-medium tracking-[0.03em] text-slate-400 tabular-nums">0410 323 034</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const panel = document.getElementById('mobile-menu-panel');
  const links = document.querySelectorAll('[data-mobile-nav-link]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    links.forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
