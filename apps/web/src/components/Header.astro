---
/**
 * Short labels + single-line nav — luxury horizontal rhythm (architecture-firm density).
 * Routes unchanged; mobile uses same `navLinks`.
 */
const navLinks = [
  { href: '/for-builders', label: 'Builders' },
  { href: '/services/smart-home', label: 'Smart Systems' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/pre-purchase-inspection', label: 'Inspections' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="bg-brand-navy text-white sticky top-0 z-40 border-b border-white/[0.06]">
  <div
    class="bht-header-inner mx-auto flex max-w-[90rem] flex-nowrap items-center justify-between gap-8 px-6 py-3.5 min-h-[5.75rem] md:min-h-[6.25rem] md:gap-10 md:px-10 md:py-4 lg:gap-14 lg:px-12"
  >
    <!-- Wordmark only — no slogan in header (positioning lives in Hero). -->
    <a
      href="/"
      class="group flex shrink-0 items-center gap-4 md:gap-5"
      aria-label="Better Home — Home"
    >
      <img
        src="/better_home_logo.svg"
        alt=""
        width="68"
        height="68"
        class="h-[3.35rem] w-[3.35rem] translate-y-[2px] md:h-[4rem] md:w-[4rem] md:translate-y-[3px] flex-shrink-0 object-contain select-none contrast-[1.06] opacity-[0.98] group-hover:opacity-100 transition-opacity duration-300"
        aria-hidden="true"
        decoding="async"
      />
      <span
        class="text-[17px] font-semibold uppercase leading-none tracking-[0.1em] text-white md:text-[18px] md:tracking-[0.09em]"
        style="font-family: var(--font-display)"
      >
        Better Home
      </span>
    </a>

    <nav
      class="hidden min-w-0 flex-1 flex-nowrap items-center justify-center gap-4 md:flex lg:gap-5 xl:gap-6"
      aria-label="Primary"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="whitespace-nowrap text-[13px] font-medium leading-none tracking-[0.025em] text-slate-400/95 transition-colors duration-500 ease-out hover:text-slate-100/95 lg:text-[14.5px]"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden shrink-0 items-center md:flex">
      <a
        href="tel:0410323034"
        class="bht-header-phone inline-flex items-center ml-4 border-l border-white/[0.1] pl-6 text-[12.5px] font-medium leading-none tracking-[0.012em] text-slate-400/90 transition-colors duration-500 tabular-nums hover:text-slate-200/95 lg:ml-6 lg:pl-8 lg:text-[13px]"
      >
        0410 323 034
      </a>
    </div>

    <div class="flex shrink-0 items-center gap-3 md:hidden">
      <a
        href="tel:0410323034"
        class="text-[13px] font-medium tracking-[0.03em] text-slate-400 transition-colors duration-300 hover:text-slate-200"
      >
        Call
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md border border-white/20 px-3 py-2 text-[14px] font-semibold text-white transition hover:border-white/35 hover:text-white"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
      >
        Menu
      </button>
    </div>
  </div>

  <nav id="mobile-menu-panel" class="md:hidden hidden border-t border-white/10 bg-brand-navy/98">
    <div class="mx-auto max-w-[90rem] px-6 py-3 flex flex-col text-[15px] tracking-[0.04em]">
      <a href="/" data-mobile-nav-link class="py-3 text-slate-200 hover:text-white border-b border-white/5">Home</a>
      {navLinks.map((link) => (
        <a href={link.href} data-mobile-nav-link class="py-3 text-slate-200 hover:text-white border-b border-white/5">
          {link.label}
        </a>
      ))}
      <a href="tel:0410323034" data-mobile-nav-link class="py-3 text-[13px] font-medium tracking-[0.03em] text-slate-400 tabular-nums">0410 323 034</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const panel = document.getElementById('mobile-menu-panel');
  const links = document.querySelectorAll('[data-mobile-nav-link]');

  if (toggle && panel) {
    const setOpen = (open) => {
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    links.forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
