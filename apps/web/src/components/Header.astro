---
const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/insights', label: 'Insights' },
  { href: '/pre-purchase-inspection', label: 'Pre-Purchase' },
  { href: '/for-builders', label: 'For Builders' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<header class="bg-brand-navy text-white sticky top-0 z-40 border-b border-white/[0.08]">
  <div class="mx-auto max-w-6xl px-6 lg:px-10 min-h-[4.25rem] md:min-h-[5rem] flex items-center justify-between py-3 md:py-0">
    <!-- BH Logo: architectural line-mark + dual-line wordmark -->
    <a href="/" class="flex items-center gap-3 group" aria-label="Better Home Technology — Home">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 58 52"
        class="h-9 md:h-10 w-auto flex-shrink-0 text-brand-amber"
        aria-hidden="true"
      >
        <!-- B: spine -->
        <line x1="5" y1="3" x2="5" y2="49" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- B: top arm -->
        <line x1="5" y1="3" x2="21" y2="3" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- B: top-right chamfer (architectural detail) -->
        <line x1="21" y1="3" x2="27" y2="9" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- B: upper bump right -->
        <line x1="27" y1="9" x2="27" y2="26" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- B: middle crossbar -->
        <line x1="5" y1="26" x2="27" y2="26" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- B: lower bump right -->
        <line x1="27" y1="26" x2="27" y2="43" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- B: bottom-right chamfer -->
        <line x1="27" y1="43" x2="21" y2="49" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- B: bottom arm -->
        <line x1="21" y1="49" x2="5" y2="49" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- H: left vertical -->
        <line x1="34" y1="3" x2="34" y2="49" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- H: right vertical -->
        <line x1="53" y1="3" x2="53" y2="49" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
        <!-- H: crossbar -->
        <line x1="34" y1="26" x2="53" y2="26" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"/>
      </svg>
      <span class="flex flex-col leading-none gap-1">
        <span
          class="text-white font-semibold uppercase tracking-[0.14em] text-[14px] md:text-[15px]"
          style="font-family: var(--font-display)"
        >Better Home</span>
        <span
          class="text-brand-amber/90 font-medium uppercase tracking-[0.22em] text-[9px] md:text-[10px]"
          style="font-family: var(--font-display)"
        >Technology</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7 lg:gap-8 text-[13px] tracking-[0.06em]">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-slate-400 hover:text-brand-amber transition-colors duration-300"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="tel:0410323034"
      class="hidden md:inline-flex items-center text-brand-amber/85 hover:text-brand-amber font-medium text-[13px] tracking-[0.04em] transition-colors"
    >
      0410 323 034
    </a>

    <div class="md:hidden flex items-center gap-3">
      <a
        href="tel:0410323034"
        class="text-brand-amber font-semibold text-sm"
      >
        Call
      </a>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md border border-white/20 px-3 py-2 text-sm font-semibold text-white hover:border-brand-amber hover:text-brand-amber transition"
        aria-controls="mobile-menu-panel"
        aria-expanded="false"
      >
        Menu
      </button>
    </div>
  </div>

  <nav id="mobile-menu-panel" class="md:hidden hidden border-t border-white/10 bg-brand-navy/98">
    <div class="mx-auto max-w-6xl px-6 py-3 flex flex-col">
      <a href="/" data-mobile-nav-link class="py-3 text-slate-200 hover:text-white border-b border-white/5">Home</a>
      {navLinks.map((link) => (
        <a href={link.href} data-mobile-nav-link class="py-3 text-slate-200 hover:text-white border-b border-white/5">
          {link.label}
        </a>
      ))}
      <a href="tel:0410323034" data-mobile-nav-link class="py-3 text-brand-amber font-semibold">Call 0410 323 034</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const panel = document.getElementById('mobile-menu-panel');
  const links = document.querySelectorAll('[data-mobile-nav-link]');

  if (toggle && panel) {
    const setOpen = (open) => {
      panel.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    links.forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
