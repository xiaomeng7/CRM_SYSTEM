---
import type { NavGroup } from '../../lib/standards';

interface Props {
  navGroups: NavGroup[];
  currentPath?: string;
}

const { navGroups, currentPath = '' } = Astro.props;

function isActive(href: string): boolean {
  return currentPath === href || currentPath === href.replace(/\/$/, '');
}
---
<nav class="standards-nav" aria-label="Standards sections">
  <p class="mb-6 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#8a8175]">
    Sections
  </p>
  <ul class="space-y-8">
    {navGroups.map((group) => (
      <li>
        <div class="mb-3">
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6b7078]">
            {group.label}
          </p>
          {group.description && (
            <p class="mt-1 text-[12px] leading-snug text-[#8a8175]">{group.description}</p>
          )}
        </div>
        <ul class="space-y-0.5 border-l border-[#e0dbd3] pl-3">
          {group.items.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block py-2 pr-2 text-[14px] leading-snug transition-colors duration-300',
                  isActive(item.href)
                    ? 'font-medium text-[#1a1d22] border-l-2 border-[#c6a55e] -ml-[13px] pl-[11px]'
                    : 'text-[#5c6169] hover:text-[#1a1d22]',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</nav>
