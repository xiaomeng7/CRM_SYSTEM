# Runtime target. Use neon_dev for the first private preview deployment.
PRODUCT_OS_DATABASE_ENV=neon_dev

# Product OS target identity. Never substitute the CRM root DATABASE_URL.
PRODUCT_OS_DEV_DATABASE_URL=
PRODUCT_OS_DEV_HOST_FINGERPRINT=

# Required only when PRODUCT_OS_DATABASE_ENV=production.
PRODUCT_OS_PROD_DATABASE_URL=
PRODUCT_OS_PROD_HOST_FINGERPRINT=
PRODUCT_OS_PRODUCTION_CONFIRM=

# Single-administrator sign-in.
SALES_STUDIO_AUTH_MODE=single_admin_password
SALES_STUDIO_ADMIN_EMAIL=
SALES_STUDIO_ADMIN_PASSWORD=
SALES_STUDIO_SESSION_SECRET=

# Keep ServiceM8 execution disabled for preview deployments.
BETTER_HOME_HANDOFF_PROXY_ENABLED=false
BETTER_HOME_CRM_INTERNAL_URL=
BETTER_HOME_HANDOFF_INTERNAL_SECRET=
