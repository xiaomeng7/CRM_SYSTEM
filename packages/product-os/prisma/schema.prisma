model Pos2SelectionDraft {
  id             String                   @id @default(uuid()) @db.Uuid
  draftCode      String                   @unique @map("draft_code")
  status         Pos2SelectionDraftStatus @default(DRAFT)
  customerName   String?                  @map("customer_name")
  customerEmail  String?                  @map("customer_email")
  customerPhone  String?                  @map("customer_phone")
  siteAddress    String?                  @map("site_address")
  currentVersion Int                      @default(0) @map("current_version")
  createdBy      String?                  @map("created_by")
  ownerUserId    String?                  @map("owner_user_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions       Pos2SelectionDraftVersion[]
  ownerUser      Pos2SalesUser?           @relation("Pos2DraftOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
