  acceptedFingerprint String                      @map("accepted_fingerprint")
  acceptedTotal      Decimal                      @map("accepted_total") @db.Decimal(12, 2)
  currencyCode       String                       @map("currency_code") @db.VarChar(3)
  acceptedByName     String                       @map("accepted_by_name")
  acceptedByContact  String?                      @map("accepted_by_contact")
  notes              String?
  recordedByUserId   String                       @map("recorded_by_user_id") @db.Uuid
  acceptedAt         DateTime                     @map("accepted_at") @db.Timestamptz(6)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  proposal           Pos2Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
