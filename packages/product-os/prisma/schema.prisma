  sourceStableId  String?  @map("source_stable_id")
  transformation  String?  @map("transformation")
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  importBatch     Pos2ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
