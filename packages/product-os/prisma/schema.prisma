model Pos2OperationalHandoff {
  id                 String                          @id @default(uuid()) @db.Uuid
  proposalId         String                          @unique @map("proposal_id") @db.Uuid
  operation          Pos2OperationalHandoffOperation @default(CREATE_SERVICEM8_WORK_ORDER)
  status             Pos2OperationalHandoffStatus    @default(PENDING)
  idempotencyKey     String                          @unique @map("idempotency_key")
  crmOpportunityId   String                          @map("crm_opportunity_id")
  crmAccountId       String                          @map("crm_account_id")
  crmContactId       String                          @map("crm_contact_id")
  crmAssetId         String                          @map("crm_asset_id")
  serviceM8JobUuid   String?                         @map("servicem8_job_uuid")
  authorizedByUserId String?                         @map("authorized_by_user_id") @db.Uuid
  authorizedPayloadHash String?                      @map("authorized_payload_hash")
  authorizedPayloadSnapshot Json?                    @map("authorized_payload_snapshot")
  authorizedAt       DateTime?                       @map("authorized_at") @db.Timestamptz(6)
  attemptCount       Int                             @default(0) @map("attempt_count")
  lastError          String?                         @map("last_error")
  requestedAt        DateTime                        @default(now()) @map("requested_at") @db.Timestamptz(6)
  processingAt       DateTime?                       @map("processing_at") @db.Timestamptz(6)
  completedAt        DateTime?                       @map("completed_at") @db.Timestamptz(6)
