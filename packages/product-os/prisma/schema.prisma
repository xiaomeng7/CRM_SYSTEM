  @@index([importBatchId, entityType])
  @@map("pos2_source_provenance")
}

model Pos2ValidationRun {
  id            String   @id @default(uuid()) @db.Uuid
  runCode       String   @unique @map("run_code")
  releaseId     String?  @map("release_id") @db.Uuid
  importBatchId String?  @map("import_batch_id") @db.Uuid
  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  status        String
  summary       Json?

  release       Pos2Release?     @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  importBatch   Pos2ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  results       Pos2ValidationResult[]

  @@map("pos2_validation_runs")
}

model Pos2ValidationResult {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  ruleCode    String   @map("rule_code")
  severity    String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  message     String
  passed      Boolean
  provenance  Json?
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run         Pos2ValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

