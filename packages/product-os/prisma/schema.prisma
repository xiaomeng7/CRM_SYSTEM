model Pos2SelectionDraftVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  draftId              String   @map("draft_id") @db.Uuid
  versionNumber        Int      @map("version_number")
  selectionFingerprint String   @map("selection_fingerprint")
  customerSnapshot     Json     @map("customer_snapshot")
  currencyCode         String   @map("currency_code") @db.VarChar(3)
  taxBasis             String   @map("tax_basis")
  total                Decimal  @db.Decimal(12, 2)
  createdBy            String?  @map("created_by")
  actorUserId          String?  @map("actor_user_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  draft                Pos2SelectionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  lines                Pos2SelectionDraftLine[]
  proposals            Pos2Proposal[]
  actorUser            Pos2SalesUser? @relation("Pos2DraftVersionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([draftId, versionNumber])
  @@index([selectionFingerprint])
  @@map("pos2_selection_draft_versions")
}

model Pos2SelectionDraftLine {
  id                  String   @id @default(uuid()) @db.Uuid
  draftVersionId      String   @map("draft_version_id") @db.Uuid
