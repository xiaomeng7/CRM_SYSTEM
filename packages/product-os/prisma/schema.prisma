  @@unique([draftVersionId, productId])
  @@map("pos2_selection_draft_lines")
}

model Pos2Proposal {
  id                   String             @id @default(uuid()) @db.Uuid
  proposalCode         String             @unique @map("proposal_code")
  draftVersionId       String             @map("draft_version_id") @db.Uuid
  status               Pos2ProposalStatus @default(DRAFT)
  selectionFingerprint String             @map("selection_fingerprint")
  projectionSnapshot   Json               @map("projection_snapshot")
  total                Decimal            @db.Decimal(12, 2)
  currencyCode         String             @map("currency_code") @db.VarChar(3)
  taxBasis             String             @map("tax_basis")
  approvedBy           String?            @map("approved_by")
  approvedByUserId     String?            @map("approved_by_user_id") @db.Uuid
  approvedAt           DateTime?          @map("approved_at") @db.Timestamptz(6)
  sentAt               DateTime?          @map("sent_at") @db.Timestamptz(6)
  expiresAt            DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  draftVersion         Pos2SelectionDraftVersion @relation(fields: [draftVersionId], references: [id], onDelete: Restrict)
  approvedByUser       Pos2SalesUser? @relation("Pos2ProposalApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  deliveries           Pos2ProposalDelivery[]
  acceptance           Pos2ProposalAcceptance?
  operationalHandoff   Pos2OperationalHandoff?

  @@index([status, updatedAt])
  @@index([draftVersionId])
  @@map("pos2_proposals")
}

model Pos2SalesUser {
  id              String              @id @default(uuid()) @db.Uuid
  email           String              @unique
  displayName     String              @map("display_name")
  role            Pos2SalesRole       @default(SALES)
  status          Pos2SalesUserStatus @default(INVITED)
  authProvider    String?             @map("auth_provider")
  externalSubject String?             @unique @map("external_subject")
  passwordHash    String?             @map("password_hash")
  mustChangePassword Boolean          @default(true) @map("must_change_password")
  passwordChangedAt DateTime?         @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedDrafts     Pos2SelectionDraft[] @relation("Pos2DraftOwner")
  draftVersions   Pos2SelectionDraftVersion[] @relation("Pos2DraftVersionActor")
  approvedProposals Pos2Proposal[] @relation("Pos2ProposalApprover")
  confirmedCustomerLinks Pos2DraftCustomerLink[] @relation("Pos2CustomerLinkConfirmer")
  recordedDeliveries Pos2ProposalDelivery[] @relation("Pos2ProposalDeliveryRecorder")
  recordedAcceptances Pos2ProposalAcceptance[] @relation("Pos2ProposalAcceptanceRecorder")
  authorizedHandoffs Pos2OperationalHandoff[] @relation("Pos2OperationalHandoffAuthorizer")

  @@index([status, role])
  @@map("pos2_sales_users")
}

model Pos2ProposalDelivery {
