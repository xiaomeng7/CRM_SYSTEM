model Pos2SourceSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  snapshotCode String   @unique @map("snapshot_code")
  filename     String
  sha256       String
  byteSize     Int      @map("byte_size")
  sourceKind   String   @map("source_kind")
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  notes        String?

  importBatches Pos2ImportBatch[]

  @@map("pos2_source_snapshots")
}

model Pos2ImportBatch {
  id               String         @id @default(uuid()) @db.Uuid
  batchCode        String         @unique @map("batch_code")
  sourceSnapshotId String?        @map("source_snapshot_id") @db.Uuid
  mode             Pos2ImportMode @default(DRY_RUN)
  status           String
  startedAt        DateTime       @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?      @map("finished_at") @db.Timestamptz(6)
  stats            Json?
  notes            String?

  sourceSnapshot   Pos2SourceSnapshot? @relation(fields: [sourceSnapshotId], references: [id], onDelete: SetNull)
  provenances      Pos2SourceProvenance[]
  validationRuns   Pos2ValidationRun[]

  @@map("pos2_import_batches")
}

model Pos2SourceProvenance {
  id              String   @id @default(uuid()) @db.Uuid
