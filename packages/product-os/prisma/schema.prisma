  @@index([proposalId, deliveredAt])
  @@map("pos2_proposal_deliveries")
}

model Pos2ProposalAcceptance {
  id                 String                       @id @default(uuid()) @db.Uuid
  proposalId         String                       @unique @map("proposal_id") @db.Uuid
  method             Pos2ProposalAcceptanceMethod
