}

model Pos2DraftCustomerLink {
  id                String                   @id @default(uuid()) @db.Uuid
  draftId           String                   @unique @map("draft_id") @db.Uuid
  crmContactId      String?                  @map("crm_contact_id")
  crmAccountId      String?                  @map("crm_account_id")
  crmAssetId        String?                  @map("crm_asset_id")
  crmOpportunityId  String?                  @map("crm_opportunity_id")
  status            Pos2CustomerLinkStatus   @default(PENDING_REVIEW)
  matchMethod       Pos2CustomerMatchMethod? @map("match_method")
  candidateSnapshot Json?                    @map("candidate_snapshot")
  confirmedByUserId String?                  @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime?                @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
