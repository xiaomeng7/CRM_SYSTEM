generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  INFRASTRUCTURE
  COLLECTION
  EXPERIENCE_PACK
}

enum RecordStatus {
  DRAFT
  ACTIVE
  FROZEN
  ARCHIVED
}

enum IncludedType {
  STANDARD
  OPTIONAL
  UPGRADE
}

model Setting {
  id            String   @id @default(uuid()) @db.Uuid
  settingKey    String   @unique @map("setting_key")
  numericValue  Decimal? @map("numeric_value") @db.Decimal(12, 4)
  textValue     String?  @map("text_value")
  booleanValue  Boolean? @map("boolean_value")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model ProductCatalog {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  type                ProductType
  name                String
  version             String               @default("1.0")
  status              RecordStatus         @default(DRAFT)
  coreValue           String?              @map("core_value")
  primaryEmotion      String?              @map("primary_emotion")
  coverage            String?
  hero                String?
  subtitle            String?
  story               String?
  finalInstalledPrice Decimal              @map("final_installed_price") @db.Decimal(12, 2)
  requiresFoundation  Boolean              @default(true) @map("requires_foundation")
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  bomItems            ProductBom[]
  labourItems         ProductLabour[]
  experiences         ProductExperience[]
  capabilities        ProductCapability[]
  rules               ProductRule[]
  contentItems        ProductContent[]
  icons               ProductIcon[]
  images              ProductImage[]
  themes              ProductTheme[]
  layouts             ProductLayout[]
  automations         ProductAutomation[]
  changeLogs          ChangeLog[]

  @@index([type, status])
  @@map("product_catalog")
}

model SkuLibrary {
  id            String      @id @default(uuid()) @db.Uuid
  sku           String      @unique
  productName   String      @map("product_name")
  category      String?
  brand         String?
  supplier      String?
  unitCostExGst Decimal     @map("unit_cost_ex_gst") @db.Decimal(12, 2)
  status        RecordStatus @default(ACTIVE)
  notes         String?
  bomItems      ProductBom[]

  @@map("sku_library")
}

model LabourLibrary {
  id          String         @id @default(uuid()) @db.Uuid
  labourItem  String         @unique @map("labour_item")
  hours       Decimal        @db.Decimal(10, 2)
  category    String?
  notes       String?
  productUses ProductLabour[]

  @@map("labour_library")
}

model ProductBom {
  id           String       @id @default(uuid()) @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  skuId        String       @map("sku_id") @db.Uuid
  qty          Decimal      @db.Decimal(12, 3)
  includedType IncludedType @default(STANDARD) @map("included_type")
  notes        String?
  product      ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          SkuLibrary     @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([productId, skuId])
  @@map("product_bom")
}

model ProductLabour {
  id           String       @id @default(uuid()) @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  labourItemId String       @map("labour_item_id") @db.Uuid
  qty          Decimal      @db.Decimal(10, 2)
  notes        String?
  product      ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)
  labourItem   LabourLibrary  @relation(fields: [labourItemId], references: [id], onDelete: Restrict)

  @@unique([productId, labourItemId])
  @@map("product_labour")
}

model ProductExperience {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  sequence    Int
  title       String
  description String?
  status      RecordStatus  @default(ACTIVE)
  product     ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sequence])
  @@map("product_experiences")
}

model ProductCapability {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  capability    String
  includedQty   Decimal?      @map("included_qty") @db.Decimal(12, 3)
  customerLayer String?       @map("customer_layer")
  notes         String?
  product       ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_capabilities")
}

model ProductRule {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  ruleKey   String        @map("rule_key")
  ruleValue String        @map("rule_value")
  notes     String?
  product   ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ruleKey])
  @@map("product_rules")
}

model ProductContent {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  contentType String        @map("content_type")
  contentKey  String        @map("content_key")
  sequence    Int           @default(1)
  title       String?
  body        String?
  status      RecordStatus  @default(ACTIVE)
  notes       String?
  product     ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, contentType, contentKey, sequence])
  @@map("product_content")
}

model ProductIcon {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  iconKey   String        @map("icon_key")
  title     String?
  assetUrl  String?       @map("asset_url")
  sequence  Int           @default(1)
  status    RecordStatus  @default(ACTIVE)
  notes     String?
  product   ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, iconKey, sequence])
  @@map("product_icons")
}

model ProductImage {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  imageType   String        @map("image_type")
  imageUrl    String        @map("image_url")
  altText     String?       @map("alt_text")
  sequence    Int           @default(1)
  status      RecordStatus  @default(ACTIVE)
  notes       String?
  product     ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, imageType, sequence])
  @@map("product_images")
}

model ProductTheme {
  id               String        @id @default(uuid()) @db.Uuid
  productId        String        @map("product_id") @db.Uuid
  themeKey         String        @map("theme_key")
  primaryColor     String?       @map("primary_color")
  secondaryColor   String?       @map("secondary_color")
  typographyScheme String?       @map("typography_scheme")
  status           RecordStatus  @default(ACTIVE)
  notes            String?
  product          ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, themeKey])
  @@map("product_theme")
}

model ProductLayout {
  id           String        @id @default(uuid()) @db.Uuid
  productId    String        @map("product_id") @db.Uuid
  layoutKey    String        @map("layout_key")
  renderTarget String?       @map("render_target")
  definition   Json?
  status       RecordStatus  @default(ACTIVE)
  notes        String?
  product      ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, layoutKey])
  @@map("product_layout")
}

model ProductAutomation {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  sequence    Int           @default(1)
  automationKey String      @map("automation_key")
  title       String
  description String?
  triggerType String?       @map("trigger_type")
  status      RecordStatus  @default(ACTIVE)
  notes       String?
  product     ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, automationKey, sequence])
  @@map("product_automation")
}

model ChangeLog {
  id              String        @id @default(uuid()) @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  changedBy       String?       @map("changed_by")
  changeType      String        @map("change_type")
  changeSummary   String?       @map("change_summary")
  previousVersion String?       @map("previous_version")
  newVersion      String?       @map("new_version")
  metadata        Json?
  changedAt       DateTime      @default(now()) @map("changed_at") @db.Timestamptz(6)
  product         ProductCatalog? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId, changedAt])
  @@map("change_log")
}


// =============================================================================
// Product OS V2 (additive) — Phase 3A
// Physical tables use pos2_ prefix in the default public schema.
// ADR-008: prefixed tables preferred over Prisma multi-schema for tooling safety.
// V1 models above MUST remain unchanged. No V2 seed of product facts in Phase 3A.
// =============================================================================

enum Pos2ProductKind {
  FOUNDATION
  COLLECTION
  EXPERIENCE
  ADDON
  STANDALONE
}

enum Pos2CommercialRole {
  STANDARD
  PACK
  BONUS
}

enum Pos2LifecycleStatus {
  DRAFT
  ACTIVE
  FROZEN
  ARCHIVED
}

enum Pos2RelationshipType {
  PREREQUISITE
  COMPATIBLE_EXPERIENCE
  RECOMMENDED_NEXT_PRODUCT
  BONUS_PREREQUISITE
  BONUS_UNLOCK
  DEPENDENCY
  PRESENTATION_CTA
}

enum Pos2RequirementLogic {
  AND
  OR
}

enum Pos2ContentKind {
  HERO
  SUBTITLE
  STORY_TITLE
  STORY_BODY
  FRONT_MOMENT_TITLE
  FRONT_MOMENT_CAPTION
  PROBLEM
  BETTER_HOME_RESPONSE
  CUSTOMER_EXPERIENCE_COPY
  INSTALLATION_ASSUMPTION_CUSTOMER
  FOOTER
  ADDON_EXPERIENCE_PROMISE
}

enum Pos2ContentSide {
  FRONT
  BACK
  NA
}

enum Pos2AssumptionLayer {
  CUSTOMER
  TECHNICAL
}

enum Pos2TaxBasis {
  GST_INCLUSIVE
  GST_EXCLUSIVE
  GST_FREE
}

enum Pos2PriceDisplayMode {
  EXACT
  FROM
  CONTACT
}

enum Pos2PriceFulfilmentMode {
  INSTALLED
  SUPPLY_ONLY
}

enum Pos2PublishStatus {
  DRAFT
  APPROVED
  NOT_APPROVED_FOR_PUBLISH
  RETIRED
}

enum Pos2ThemeScope {
  GLOBAL
  CHANNEL
  PRODUCT
}

enum Pos2InclusionType {
  STANDARD
  OPTIONAL
  UPGRADE
}

enum Pos2SupportKind {
  BOM_ITEM
  RULE
  NON_HARDWARE
}

enum Pos2ReleaseComponentKind {
  PRODUCT_VERSION
  BOM_VERSION
  LABOUR_VERSION
  PRICE
  CONTENT_ENTRY
  AUTOMATION
  THEME
  LAYOUT
  ASSET
}

enum Pos2ImportMode {
  DRY_RUN
  APPLY
}

enum Pos2IssueStatus {
  OPEN
  NEEDS_SOURCE
  NEEDS_PRODUCT_OWNER
  RESOLVED
  DEFERRED
  NOT_A_CONFLICT
}

enum Pos2AliasResolutionKind {
  PRODUCT
  INCLUDED_BENEFIT
  WITHDRAWN
}

enum Pos2SelectionDraftStatus {
  DRAFT
  READY_FOR_REVIEW
  CONVERTED
  ARCHIVED
}

enum Pos2ProposalStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum Pos2SalesRole {
  SALES
  MANAGER
  ADMIN
}

enum Pos2SalesUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Pos2CustomerLinkStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

enum Pos2CustomerMatchMethod {
  EXPLICIT_ID
  EMAIL_EXACT
  PHONE_EXACT
  MANUAL
  NEW_CUSTOMER
}

enum Pos2ProposalDeliveryChannel {
  EMAIL
  MANUAL_HANDOFF
  OTHER
}

enum Pos2ProposalAcceptanceMethod {
  SIGNED_DOCUMENT
  EMAIL_CONFIRMATION
  PORTAL
  IN_PERSON
  OTHER
}

enum Pos2OperationalHandoffStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum Pos2OperationalHandoffOperation {
  CREATE_SERVICEM8_WORK_ORDER
}

/// Canonical V2 product catalogue node (dual-axis kind × commercial role).
model Pos2Product {
  id                 String             @id @default(uuid()) @db.Uuid
  productCode        String             @unique @map("product_code")
  canonicalName      String             @map("canonical_name")
  productKind        Pos2ProductKind    @map("product_kind")
  commercialRole     Pos2CommercialRole @default(STANDARD) @map("commercial_role")
  status             Pos2LifecycleStatus @default(DRAFT)
  parentProductId    String?            @map("parent_product_id") @db.Uuid
  coverage           String?
  requiresFoundation Boolean            @default(true) @map("requires_foundation")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?          @map("archived_at") @db.Timestamptz(6)

  parent             Pos2Product?       @relation("Pos2ProductHierarchy", fields: [parentProductId], references: [id], onDelete: SetNull)
  children           Pos2Product[]      @relation("Pos2ProductHierarchy")
  versions           Pos2ProductVersion[]
  addonProfile       Pos2AddonProfile?
  addonEligibilitiesAsAddon  Pos2AddonParentEligibility[] @relation("Pos2AddonSide")
  addonEligibilitiesAsParent Pos2AddonParentEligibility[] @relation("Pos2ParentSide")
  featuredAsParent   Pos2ProductFeaturedAddon[] @relation("Pos2FeaturedParent")
  featuredAsAddon    Pos2ProductFeaturedAddon[] @relation("Pos2FeaturedAddon")
  installationAssumptions Pos2InstallationAssumption[]
  capabilityInclusions Pos2ProductCapability[]
  experiences        Pos2Experience[]
  relationshipsFrom  Pos2ProductRelationship[] @relation("Pos2RelFrom")
  relationshipsTo    Pos2ProductRelationship[] @relation("Pos2RelTo")
  relationshipRequirements Pos2RelationshipRequirement[]
  scopeGroups        Pos2ScopeGroup[]
  bomVersions        Pos2BomVersion[]
  labourVersions     Pos2LabourVersion[]
  rules              Pos2RuleDefinition[]
  productAutomations Pos2ProductAutomation[]
  prices             Pos2ProductPrice[]
  contentPlacements  Pos2ProductContentPlacement[]
  imageLinks         Pos2ProductImageLink[]
  themes             Pos2Theme[]
  layoutConfigs      Pos2LayoutConfig[]
  footerConfigs      Pos2FooterConfig[]
  aliasesAsCanonical Pos2ProductAlias[] @relation("Pos2AliasCanonicalProduct")
  includedBenefits   Pos2IncludedBenefit[]
  selectionDraftLines Pos2SelectionDraftLine[]

  @@unique([canonicalName, productKind])
  @@index([productKind, commercialRole, status])
  @@map("pos2_products")
}

/// Legacy / external identifier crosswalk. Never silently rewrite historical codes.
model Pos2ProductAlias {
  id                   String                 @id @default(uuid()) @db.Uuid
  aliasCode            String                 @map("alias_code")
  aliasSystem          String                 @map("alias_system")
  resolutionKind       Pos2AliasResolutionKind @map("resolution_kind")
  canonicalProductId   String?                @map("canonical_product_id") @db.Uuid
  includedBenefitCode  String?                @map("included_benefit_code")
  sourceLabel          String?                @map("source_label")
  notes                String?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  canonicalProduct     Pos2Product?           @relation("Pos2AliasCanonicalProduct", fields: [canonicalProductId], references: [id], onDelete: SetNull)
  includedBenefit      Pos2IncludedBenefit?   @relation(fields: [includedBenefitCode], references: [benefitCode], onDelete: SetNull)

  @@unique([aliasCode, aliasSystem])
  @@index([resolutionKind])
  @@map("pos2_product_aliases")
}

/// Non-product included benefit (e.g. Protection Bonus on CCTV). Not a Product ID.
model Pos2IncludedBenefit {
  id                     String              @id @default(uuid()) @db.Uuid
  benefitCode            String              @unique @map("benefit_code")
  hostProductId          String              @map("host_product_id") @db.Uuid
  displayName            String              @map("display_name")
  quoteShowsZeroValue    Boolean             @default(true) @map("quote_shows_zero_value")
  showOnConfigurator     Boolean             @default(true) @map("show_on_configurator")
  showOnA4               Boolean             @default(true) @map("show_on_a4")
  unlockRelationshipId   String?             @map("unlock_relationship_id") @db.Uuid
  status                 Pos2LifecycleStatus @default(ACTIVE)
  notes                  String?
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  hostProduct            Pos2Product         @relation(fields: [hostProductId], references: [id], onDelete: Cascade)
  unlockRelationship     Pos2ProductRelationship? @relation(fields: [unlockRelationshipId], references: [id], onDelete: SetNull)
  aliases                Pos2ProductAlias[]

  @@index([hostProductId, status])
  @@map("pos2_included_benefits")
}

model Pos2ProductVersion {
  id                   String              @id @default(uuid()) @db.Uuid
  productId            String              @map("product_id") @db.Uuid
  versionLabel         String              @map("version_label")
  status               Pos2LifecycleStatus @default(DRAFT)
  effectiveFrom        DateTime?           @map("effective_from") @db.Timestamptz(6)
  effectiveTo          DateTime?           @map("effective_to") @db.Timestamptz(6)
  supersedesVersionId  String?             @map("supersedes_version_id") @db.Uuid
  changeSummary        String?             @map("change_summary")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  product              Pos2Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supersedes           Pos2ProductVersion? @relation("Pos2VersionChain", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededBy         Pos2ProductVersion[] @relation("Pos2VersionChain")
  releaseComponents    Pos2ReleaseComponent[]

  @@unique([productId, versionLabel])
  @@map("pos2_product_versions")
}

model Pos2Release {
  id          String              @id @default(uuid()) @db.Uuid
  releaseCode String              @unique @map("release_code")
  label       String
  status      Pos2LifecycleStatus @default(DRAFT)
  releasedAt  DateTime?           @map("released_at") @db.Timestamptz(6)
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  components  Pos2ReleaseComponent[]
  validationRuns Pos2ValidationRun[]

  @@map("pos2_releases")
}

model Pos2ReleaseComponent {
  id            String                 @id @default(uuid()) @db.Uuid
  releaseId     String                 @map("release_id") @db.Uuid
  componentKind Pos2ReleaseComponentKind @map("component_kind")
  componentId   String                 @map("component_id") @db.Uuid
  productId     String?                @map("product_id") @db.Uuid
  productVersionId String?             @map("product_version_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  release       Pos2Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  productVersion Pos2ProductVersion?   @relation(fields: [productVersionId], references: [id], onDelete: SetNull)

  @@unique([releaseId, componentKind, componentId])
  @@index([releaseId])
  @@map("pos2_release_components")
}

model Pos2AddonProfile {
  productId              String   @id @map("product_id") @db.Uuid
  /// Add-ons may extend a product capability, a BOM SKU, or both. Equipment-only
  /// extensions must not require an invented capability merely to satisfy storage.
  extendsCapabilityId    String?  @map("extends_capability_id") @db.Uuid
  expandsSkuId           String?  @map("expands_sku_id") @db.Uuid
  standardScopeUnit      String?  @map("standard_scope_unit")
  experiencePromiseKey   String?  @map("experience_promise_key")
  createsNewRoom         Boolean  @default(false) @map("creates_new_room")
  createsNewExperience   Boolean  @default(false) @map("creates_new_experience")
  maxQuantity            Decimal? @map("max_quantity") @db.Decimal(12, 3)
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product                Pos2Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  extendsCapability      Pos2Capability? @relation(fields: [extendsCapabilityId], references: [id], onDelete: Restrict)
  expandsSku             Pos2EquipmentSku? @relation(fields: [expandsSkuId], references: [id], onDelete: SetNull)
  equipmentBases         Pos2AddonEquipmentBasis[]

  @@map("pos2_addon_profiles")
}

/// Every equipment item an Add-on is permitted to extend. This preserves
/// composite Add-ons without flattening them into a made-up capability.
model Pos2AddonEquipmentBasis {
  id             String   @id @default(uuid()) @db.Uuid
  addonProductId String   @map("addon_product_id") @db.Uuid
  skuId          String   @map("sku_id") @db.Uuid
  sequence       Int      @default(1)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  addonProfile   Pos2AddonProfile @relation(fields: [addonProductId], references: [productId], onDelete: Cascade)
  sku            Pos2EquipmentSku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@unique([addonProductId, skuId])
  @@unique([addonProductId, sequence])
  @@map("pos2_addon_equipment_bases")
}

model Pos2AddonParentEligibility {
  id              String              @id @default(uuid()) @db.Uuid
  addonProductId  String              @map("addon_product_id") @db.Uuid
  parentProductId String              @map("parent_product_id") @db.Uuid
  status          Pos2LifecycleStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  addonProduct    Pos2Product         @relation("Pos2AddonSide", fields: [addonProductId], references: [id], onDelete: Cascade)
  parentProduct   Pos2Product         @relation("Pos2ParentSide", fields: [parentProductId], references: [id], onDelete: Cascade)

  @@unique([addonProductId, parentProductId])
  @@map("pos2_addon_parent_eligibility")
}

model Pos2ProductFeaturedAddon {
  id              String              @id @default(uuid()) @db.Uuid
  parentProductId String              @map("parent_product_id") @db.Uuid
  addonProductId  String              @map("addon_product_id") @db.Uuid
  channel         String
  surface         String
  sortOrder       Int                 @map("sort_order")
  status          Pos2LifecycleStatus @default(ACTIVE)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  parentProduct   Pos2Product         @relation("Pos2FeaturedParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  addonProduct    Pos2Product         @relation("Pos2FeaturedAddon", fields: [addonProductId], references: [id], onDelete: Cascade)

  @@unique([parentProductId, addonProductId, channel, surface])
  @@index([parentProductId, channel, surface, sortOrder])
  @@map("pos2_product_featured_addons")
}

model Pos2InstallationAssumption {
  id             String              @id @default(uuid()) @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  assumptionCode String              @map("assumption_code")
  sequence       Int
  assumptionText String              @map("assumption_text")
  layer          Pos2AssumptionLayer @default(CUSTOMER)
  status         Pos2LifecycleStatus @default(ACTIVE)
  versionLabel   String?             @map("version_label")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Pos2Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

